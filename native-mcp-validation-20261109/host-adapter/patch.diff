index 00000000..7a72cbdf
--- /dev/null
+++ b/packages/daemon/test/codex-item-chunks.test.ts
@@ -0,0 +1,57 @@
+import { expect, it } from 'vitest'
+
+import { codexItemChunks } from '../src/adapters/codex'
+
+// Codex 0.166.0 maps an MCP isError result to failed + result + error:null.
+// Its app-server result drops isError, so the item status carries this outcome.
+const failedMcpCall = {
+  type: 'mcpToolCall' as const,
+  id: 'inspect-readme',
+  server: 'mikka',
+  tool: 'inspect_artifact',
+  arguments: { path: 'README.md' },
+  status: 'failed' as const,
+  result: {
+    content: [{ type: 'text', text: 'PRIVATE_TOOL_FAILURE' }],
+    structuredContent: { detail: 'PRIVATE_STRUCTURED_FAILURE' },
+    _meta: { detail: 'PRIVATE_META_FAILURE' },
+  },
+  error: null,
+  durationMs: 42,
+}
+
+it('rejects the official failed MCP result without copying its private content into the error', () => {
+  const chunks = codexItemChunks('completed', failedMcpCall, new Set(), '/tmp')
+  expect(chunks).toEqual([{ type: 'tool-output-error', toolCallId: 'inspect-readme', errorText: 'MCP tool call failed' }])
+  expect(JSON.stringify(chunks)).not.toContain('PRIVATE_')
+})
+
+it('rejects an explicitly failed MCP completion even when its result is absent', () => {
+  expect(codexItemChunks('completed', { ...failedMcpCall, result: null }, new Set(), '/tmp'))
+    .toEqual([{ type: 'tool-output-error', toolCallId: 'inspect-readme', errorText: 'MCP tool call failed' }])
+})
+
+it('preserves a normal completed MCP result', () => {
+  const content = [{ type: 'text', text: 'README contents' }]
+  expect(codexItemChunks('completed', { ...failedMcpCall, status: 'completed', result: { content } }, new Set(), '/tmp'))
+    .toEqual([{ type: 'tool-output-available', toolCallId: 'inspect-readme', output: content }])
+})
+
+it('preserves the MCP started input and does not emit a completion', () => {
+  expect(codexItemChunks('started', { ...failedMcpCall, status: 'inProgress', result: null }, new Set(), '/tmp'))
+    .toEqual([{ type: 'tool-input-available', toolCallId: 'inspect-readme', toolName: 'mcp__mikka__inspect_artifact', input: { path: 'README.md' } }])
+})
+
+it('preserves explicit MCP errors with or without the failed status', () => {
+  for (const status of ['completed', 'failed'] as const) {
+    expect(codexItemChunks('completed', { ...failedMcpCall, status, error: { message: 'Existing transport failure' } }, new Set(), '/tmp'))
+      .toEqual([{ type: 'tool-output-error', toolCallId: 'inspect-readme', errorText: 'Existing transport failure' }])
+  }
+})
+
+it('preserves the existing availability behavior for an item without a status', () => {
+  const legacy = { type: 'mcpToolCall' as const, id: 'legacy', server: 'mikka', tool: 'inspect_artifact',
+    arguments: {}, result: { content: [] }, error: null }
+  expect(codexItemChunks('completed', legacy, new Set(), '/tmp'))
+    .toEqual([{ type: 'tool-output-available', toolCallId: 'legacy', output: [] }])
+})

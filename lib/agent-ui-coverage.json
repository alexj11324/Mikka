{
  "checkedAt": "2026-10-21",
  "reference": "https://elements.ai-sdk.dev/llms.txt",
  "registry": "https://beui.dev/r",
  "excludedExamples": ["Chatbot", "IDE", "Workflow"],
  "scope": "对照功能而非 API 兼容性。available 表示本地源码可导入，不代表当前 Agent 已接通对应后端；不安装或导入 AI Elements。",
  "beui": {
    "message": { "source": "https://beui.dev/r/message", "path": "components/agents/message.tsx" },
    "message-bubble": { "source": "https://beui.dev/r/message-bubble", "path": "components/agents/message-bubble.tsx" },
    "message-scroller": { "source": "https://beui.dev/r/message-scroller", "path": "components/agents/message-scroller.tsx" },
    "prompt-input": { "source": "https://beui.dev/r/prompt-input", "path": "components/agents/prompt-input.tsx" },
    "todo-list": { "source": "https://beui.dev/r/todo-list", "path": "components/agents/todo-list.tsx" },
    "code-block": { "source": "https://beui.dev/r/code-block", "path": "components/agents/code-block.tsx" },
    "approval-card": { "source": "https://beui.dev/r/approval-card", "path": "components/agents/approval-card/index.tsx" },
    "file-diff": { "source": "https://beui.dev/r/file-diff", "path": "components/agents/file-diff.tsx" },
    "tool-result": { "source": "https://beui.dev/r/tool-result", "path": "components/agents/tool-result.tsx" },
    "streaming-response": { "source": "https://beui.dev/r/streaming-response", "path": "components/agents/streaming-response.tsx" },
    "image-generation": { "source": "https://beui.dev/r/image-generation", "path": "components/agents/image-generation.tsx" },
    "tool-approval": { "source": "https://beui.dev/r/tool-approval", "path": "components/agents/tool-approval.tsx" },
    "citations": { "source": "https://beui.dev/r/citations", "path": "components/agents/citations.tsx" },
    "agent-activity": { "source": "https://beui.dev/r/agent-activity", "path": "components/agents/agent-activity/index.tsx" },
    "loading-states": { "source": "https://beui.dev/r/loading-states", "path": "components/agents/loading-states/agent-progress.tsx", "relatedPaths": ["components/agents/loading-states/thinking-shimmer.tsx", "components/agents/loading-states/reasoning-text.tsx"] },
    "ai-sidebar": { "source": "https://beui.dev/r/ai-sidebar", "path": "components/agents/ai-sidebar.tsx" },
    "chat-app": { "source": "https://beui.dev/r/chat-app", "path": "components/agents/chat-app.tsx" },
    "voice-orb": { "source": "https://beui.dev/r/voice-orb", "path": "components/agents/voice-orb.tsx" },
    "file-tree": { "source": "https://beui.dev/r/file-tree", "path": "components/motion/file-tree.tsx" },
    "file-upload": { "source": "https://beui.dev/r/file-upload", "path": "components/motion/attachment-upload.tsx", "relatedPaths": ["components/motion/file-upload.tsx"] },
    "button": { "source": "https://beui.dev/r/button", "path": "components/motion/button/index.tsx" },
    "loader": { "source": "https://beui.dev/r/loader", "path": "components/motion/loader.tsx" }
  },
  "components": [
    { "element": "Attachments", "beui": ["file-upload"], "match": "partial", "usage": "available", "note": "附件展示与上传界面，不含存储后端；当前输入框未启用上传。" },
    { "element": "Chain of Thought", "beui": ["agent-activity"], "match": "partial", "usage": "available", "note": "支持步骤和活动披露；仅展示真实宿主事件，不生成模型隐私思维。" },
    { "element": "Checkpoint", "beui": [], "match": "none", "usage": "unavailable", "note": "beUI 无会话检查点及历史恢复组件。" },
    { "element": "Confirmation", "beui": ["tool-approval", "approval-card"], "match": "partial", "usage": "active", "note": "建议确认使用 ApprovalCard；真实工具授权必须使用 ToolApproval 并接通服务端校验，当前无工具。" },
    { "element": "Context", "beui": [], "match": "none", "usage": "unavailable", "note": "无 token 用量、上下文窗口及费用专用组件。" },
    { "element": "Conversation", "beui": ["message-scroller"], "match": "functional", "usage": "active", "note": "读者感知跟随、滚动及导航。" },
    { "element": "Inline Citation", "beui": ["citations"], "match": "functional", "usage": "available", "note": "引用标记及引用集合；等待真实来源数据。" },
    { "element": "Message", "beui": ["message", "message-bubble", "streaming-response"], "match": "partial", "usage": "active", "note": "消息、气泡及流式内容；无 AI Elements 同名分支 API，也不宣称内置 Markdown 解析。" },
    { "element": "Model Selector", "beui": ["prompt-input"], "match": "partial", "usage": "available", "note": "models 属性提供选择，不是可搜索模型命令面板；当前服务端固定模型，不显示无效选择。" },
    { "element": "Plan", "beui": ["todo-list"], "match": "functional", "usage": "active", "note": "建议计划强制待开始，不伪造执行进度。" },
    { "element": "Prompt Input", "beui": ["prompt-input", "file-upload"], "match": "partial", "usage": "active", "note": "输入、发送、停止、IME 保护；附件另行接入真实存储后才能启用。" },
    { "element": "Question", "beui": ["approval-card"], "match": "functional", "usage": "active", "note": "单选、多选、自由回答、多步骤及原位提交重试。" },
    { "element": "Queue", "beui": ["todo-list"], "match": "partial", "usage": "available", "note": "可展示任务列表，不提供消息队列调度。" },
    { "element": "Reasoning", "beui": ["agent-activity"], "match": "partial", "usage": "available", "note": "可折叠活动，仅供真实允许披露的宿主数据。" },
    { "element": "Shimmer", "beui": ["loading-states", "loader"], "match": "functional", "usage": "active", "note": "AgentProgress 用于真实请求；ThinkingShimmer 和 ReasoningText 源码已安装。" },
    { "element": "Sources", "beui": ["citations", "streaming-response"], "match": "functional", "usage": "available", "note": "引用列表与来源摘要，不编造来源。" },
    { "element": "Suggestion", "beui": ["button"], "match": "partial", "usage": "active", "note": "使用 beUI Button 组合建议按钮，没有独立 Suggestion 组件。" },
    { "element": "Task", "beui": ["todo-list"], "match": "functional", "usage": "active", "note": "任务状态、进度和完成计数。" },
    { "element": "Tool", "beui": ["tool-result", "agent-activity"], "match": "partial", "usage": "available", "note": "执行披露与工具事件；不开放给模型伪造调用。" },
    { "element": "Agent", "beui": [], "match": "none", "usage": "unavailable", "note": "无模型、工具和输出 schema 的 Agent 配置展示组件。" },
    { "element": "Artifact", "beui": ["streaming-response", "code-block", "image-generation"], "match": "partial", "usage": "available", "note": "可组合输出展示，不等同通用 Artifact 管理及动作 API。" },
    { "element": "Code Block", "beui": ["code-block"], "match": "functional", "usage": "available", "note": "语法高亮、行号、复制及流式更新。" },
    { "element": "Commit", "beui": ["file-diff"], "match": "partial", "usage": "available", "note": "仅文件差异展示，无 Git 提交元数据组件或提交动作。" },
    { "element": "Environment Variables", "beui": [], "match": "none", "usage": "unavailable", "note": "无环境变量遮罩和复制专用组件；不向模型传递服务端密钥。" },
    { "element": "File Tree", "beui": ["file-tree"], "match": "functional", "usage": "available", "note": "文件树、键盘导航和选择。" },
    { "element": "JSX Preview", "beui": [], "match": "none", "usage": "unavailable", "note": "无动态 JSX 执行器；当前使用注册 OpenUI 组件，不执行任意 JSX。" },
    { "element": "Package Info", "beui": [], "match": "none", "usage": "unavailable", "note": "无包版本及依赖信息专用组件。" },
    { "element": "Sandbox", "beui": ["tool-result"], "match": "partial", "usage": "available", "note": "仅执行输出展示，不具备沙箱执行后端。" },
    { "element": "Schema Display", "beui": [], "match": "none", "usage": "unavailable", "note": "无 schema 专用展示组件。" },
    { "element": "Snippet", "beui": ["code-block"], "match": "partial", "usage": "available", "note": "可组合复制代码片段，不是同名 Snippet API。" },
    { "element": "Stack Trace", "beui": ["tool-result"], "match": "partial", "usage": "available", "note": "仅原始错误输出展示，无结构化堆栈导航。" },
    { "element": "Terminal", "beui": ["tool-result"], "match": "partial", "usage": "available", "note": "语法高亮执行输出，不是交互式终端。" },
    { "element": "Test Results", "beui": ["agent-activity", "tool-result"], "match": "partial", "usage": "available", "note": "可组合真实测试事件及输出，无专用测试结果树。" },
    { "element": "Web Preview", "beui": [], "match": "none", "usage": "unavailable", "note": "无浏览器预览和 URL 导航组件。" },
    { "element": "Image", "beui": ["image-generation"], "match": "partial", "usage": "available", "note": "生成图像展示生命周期，不含图像生成服务。" },
    { "element": "Open In Chat", "beui": [], "match": "none", "usage": "unavailable", "note": "无外部聊天提供商跳转组件。" },
    { "element": "Audio Player", "beui": [], "match": "none", "usage": "unavailable", "note": "无专用音频播放组件。" },
    { "element": "Mic Selector", "beui": [], "match": "none", "usage": "unavailable", "note": "无输入音频设备选择组件。" },
    { "element": "Persona", "beui": ["voice-orb"], "match": "partial", "usage": "available", "note": "仅语音球视觉反馈，不是 Persona 状态或语音服务。" },
    { "element": "Speech Input", "beui": [], "match": "none", "usage": "unavailable", "note": "无录音和语音转文字输入组件。" },
    { "element": "Transcription", "beui": [], "match": "none", "usage": "unavailable", "note": "无分段时间轴转写组件。" },
    { "element": "Voice Selector", "beui": [], "match": "none", "usage": "unavailable", "note": "无语音选择和试听组件。" },
    { "element": "Canvas", "beui": [], "match": "none", "usage": "unavailable", "note": "无节点工作流画布组件。" },
    { "element": "Connection", "beui": [], "match": "none", "usage": "unavailable", "note": "无工作流连接状态组件。" },
    { "element": "Controls", "beui": [], "match": "none", "usage": "unavailable", "note": "无工作流画布缩放控件。" },
    { "element": "Edge", "beui": [], "match": "none", "usage": "unavailable", "note": "无工作流边组件。" },
    { "element": "Node", "beui": [], "match": "none", "usage": "unavailable", "note": "无工作流节点组件。" },
    { "element": "Panel", "beui": [], "match": "none", "usage": "unavailable", "note": "无工作流画布面板组件。" },
    { "element": "Toolbar", "beui": [], "match": "none", "usage": "unavailable", "note": "无节点工具栏组件。" }
  ]
}

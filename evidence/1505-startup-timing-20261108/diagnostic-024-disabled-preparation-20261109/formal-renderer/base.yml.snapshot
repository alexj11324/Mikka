                || authorization?.status !== 'passed' || authorization.extraRemoteCalls !== 0 || authorization.hostAuthorizationComplete !== true
                || authorization.allFirstPartyHttpComplete !== false || authorization.basis !== 'host_authorization_census_and_closed_mcp_business_paths'
                || authorization.childBusiness?.status !== 'observed' || authorization.childBusiness.generationCoverage !== 'unverified')
                failures.push('http_census_incomplete_or_extra_calls')

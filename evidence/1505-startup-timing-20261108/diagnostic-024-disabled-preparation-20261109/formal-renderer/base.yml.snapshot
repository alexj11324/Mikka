            const initialized = typeof verifyStartupInitialization === 'function' && verifyStartupInitialization(sample) === true
            const prepared = initialized && sample.preparationTimingStatus === 'complete' ? sample.daemonPreparationTiming : null
            values['daemon.adapter.preparation'] = prepared ? prepared.ms : null
            if (prepared) for (const name of new Set(prepared.phases.map(phase => phase.name)))
              values[name.replace('daemon.adapter.', 'daemon.preparation.')] = formalUnionMs(prepared.phases.filter(phase => phase.name === name))
            const initialization = initialized ? { source: prepared ? prepared.source : 'adapter_start',
              phase: 'daemon.adapter.cli_init', ms: prepared
                ? formalUnionMs(prepared.phases.filter(phase => phase.name === 'daemon.adapter.cli_init' && phase.outcome === 'ok'))
                : values['daemon.adapter.cli_init'] } : null
            if (!initialized) missing.push('daemon.adapter.cli_init')
            const bootstrap = own.filter(log => log.stage === 'cloud.sandbox.bootstrap' && formalInterval(log))
            return { status: missing.length ? 'incomplete' : 'complete', missing, valuesMs: values,

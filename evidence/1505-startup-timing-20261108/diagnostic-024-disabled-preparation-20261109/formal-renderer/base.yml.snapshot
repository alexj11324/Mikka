                || official.truncated !== false || official.invalidEvents !== 0 || official.rejectedBatches !== 0
                || !(authorization?.observedProviderEvents > 0)) failures.push('official_provider_observation_unavailable')
              if (sample.cleanup?.status !== 'passed' || sample.cleanup[`machineEnded_${sample.runId}`] !== true
                || sample.cleanup.taskDeleted !== true) failures.push('sample_cleanup_incomplete')
              if (stages.status !== 'complete') failures.push('required_stage_coverage_incomplete')
              if (stages.installation.observedBootstrapRecords) failures.push('derived_bootstrap_observed')
              return { sampleId: sample.sampleId, harness: sample.harness, runIdHash: sample.runIdHash,

                dispatchToFirstProviderChunkMs: formalMs(sample.timing?.dispatchToFirstProviderChunkMs) ? sample.timing.dispatchToFirstProviderChunkMs : null,
                postToolReply: sample.replyVerifiedAfterTool === true, stages,
                sharedSubscription: { verified: sharedConfirmed, requesterHash: shared?.requesterHash ?? null,
                  payerHash: shared?.payerHash ?? null, workspaceHash: shared?.workspaceHash ?? null,
                  access: shared?.access ?? null, profileVersion: shared?.profileVersion ?? null, profileDigest: shared?.profileDigest ?? null },
                pins: { before: sample.versionPins?.before?.sequence ?? null, after: sample.versionPins?.after?.sequence ?? null,
                  deploymentId: sample.versionPins?.before?.deploymentId ?? null, workerSha: sample.versionPins?.before?.workerRelease?.workerSha ?? null },
                http: { hostAuthorizationComplete: authorization?.hostAuthorizationComplete === true,
                  hostPhysicalSends: Array.isArray(sample.runtimeTiming?.requests) ? sample.runtimeTiming.requests.length : null,
                  extraRemoteCalls: authorization?.extraRemoteCalls ?? null,
                  allFirstPartyHttpComplete: false, allGenerationBusinessSends: null,
                  basis: authorization?.basis ?? null, childBusiness: authorization?.childBusiness ?? null,
                  naturalRefreshSends: sample.runtimeTiming?.counts?.filter(item => ['credential_refresh', 'github_credential_refresh'].includes(item.endpoint)).reduce((sum, item) => sum + item.started, 0) ?? null },
                observedOfficialProviderEvents: authorization?.observedProviderEvents ?? null,
                officialEventCompleteness: 'best_effort_flush_not_confirmed_not_a_complete_provider_count' }
            })
            if (cases.some(sample => sample.status !== 'passed')) reasons.push('case_evidence_failed')
            const groups = ['claude_code', 'codex'].map(harness => {
              const rows = cases.filter(sample => sample.harness === harness)
              return { harness, samples: rows.length, completeCases: rows.filter(sample => sample.status === 'passed').length,
                dispatchToActualAckUpperBound: formalStats(rows.map(sample => sample.acceptance?.elapsedMs ?? null)),
                dispatchToAgentStage: formalStats(rows.map(sample => sample.acceptance?.stageMs ?? null)),
                dispatchToFirstProviderChunk: formalStats(rows.map(sample => sample.dispatchToFirstProviderChunkMs)) }
            })
            report.formalAcceptance = { version: 1, profile: 'six_fresh_repository_tasks_on_derived_templates',
              status: reasons.length ? 'failed' : 'passed', driverStatus: report.status, reasons, maxStartupMs: 5000,
              logCollectionComplete: logsComplete, pinCoverageComplete: pinsComplete, sharedTeamConfirmed: teamConfirmed, cases, groups,
              diagnosticWindow: { confirmed: diagnosticWindowConfirmed, scope: 'dedicated_bot_repository_window',
                ...(expectedDiagnosticWindow ?? {}), projectRemovalRevokesActiveDeployment: false },
              resources: { requestedFreshTasks: 6, sandboxCreateSpanRecords: logs.filter(log => log.msg === 'cloud_startup_timing' && log.stage === 'cloud.sandbox.create').length,
                primaryRunMachineEndConfirmed: samples.filter(sample => sample.cleanup?.[`machineEnded_${sample.runId}`] === true).length,
                testIssueDeletionConfirmed: samples.filter(sample => sample.cleanup?.taskDeleted === true).length,
                countingBasis: 'observed_operations_not_a_provider_resource_inventory_or_invoice' },
              databaseAccounting: { status: 'unavailable', reason: 'no_complete_per_run_app_database_trace_in_this_attachment',
                httpCountsAreNotSqlCountsOrBytes: true },
              billing: { status: 'unavailable', reason: 'actual_sandbox_configuration_and_running_seconds_not_retained_by_existing_driver',
                actualCpuCount: null, actualMemoryGiB: null, actualRunningSeconds: null, estimatedComputeUsd: null,
                attribution: { compute: 'E2B account bound to the acceptance execution identity', model: 'existing official Claude and Codex subscriptions',
                  orchestration: 'existing Mikka infrastructure' },
                referenceOnly: { cpuCount: 2, memoryGiB: 4, usdPerRunningSecond: 0.000046, usdPerRunningHour: 0.1656,
                  sources: ['https://e2b.dev/pricing', 'https://docs.e2b.dev/faq/calculate-sandbox-price'] },
                exclusions: ['existing_E2B_plan', 'existing_model_subscriptions', 'existing_Mikka_infrastructure'],
                rule: 'estimate_only_from_actual_configuration_and_running_time; paused_or_killed_time_not_billed; never_use_startup_latency_or_http_count_as_running_time' } }
            return report
          }
          
          function renderAcceptanceMarkdown(report, detailMarkdown) {
            const formal = report.formalAcceptance
            const lines = ['# #1505 正式生产验收附件', '', `独立证据判定：**${formal.status}**；原 driver：**${formal.driverStatus}**。`,
              `SMOKE 共享团队身份：${formal.sharedTeamConfirmed ? 'verified' : 'unavailable'}；模型付费方必须为团队管理员共享订阅，执行请求方仍为 SMOKE。`,
              `验收使用完整 dispatch_run_entry → later(stage, 真实官方任务 ACK) 的保守上界，每轮门槛 5.000 秒。`,
              `服务端日志：${formal.logCollectionComplete ? 'query_complete，必要分段另逐轮核对' : 'incomplete / unavailable'}；版本 pin：${formal.pinCoverageComplete ? '14 / 14' : 'incomplete / unavailable'}。`,
              `诊断窗口：${formal.diagnosticWindow.confirmed ? 'verified' : 'unavailable'}；专用 Bot ${formal.diagnosticWindow.botId ?? 'unavailable'}，到期 ${formal.diagnosticWindow.expiresAt ?? 'unavailable'}。每个原版本检查点同时核对该环境 ID / value SHA；不是单 run 授权。删除项目配置不等于撤销活动 DPL 中的配置，后者仍由 expiresAt 停止开启新任务。`,
              ...(formal.reasons.length ? [`失败原因：${formal.reasons.map(reason => `\`${reason}\``).join('、')}。`] : []),
              '', '## 每轮真实任务接收与执行证据', '', '秒；ACK 上界使用同进程单调时钟差，不相减服务器与 daemon 墙钟。缺失值是 unavailable。',
              '', '| Sample | Harness | Run hash | stage | 真实 ACK 上界 | 首 provider/tool chunk | 工具后 marker | 宿主鉴权完整 / 额外鉴权 | pin before / after | 判定 |',
              '|---|---|---|---:|---:|---:|---|---|---|---|']
            for (const sample of formal.cases) lines.push(`| ${sample.sampleId} | ${sample.harness} | ${sample.runIdHash ?? 'unavailable'} | ${formalSeconds(sample.acceptance?.stageMs)} | ${formalSeconds(sample.acceptance?.elapsedMs)} | ${formalSeconds(sample.dispatchToFirstProviderChunkMs)} | ${sample.postToolReply} | ${sample.http.hostAuthorizationComplete} / ${sample.http.extraRemoteCalls ?? 'unavailable'} | ${sample.pins.before ?? 'unavailable'} / ${sample.pins.after ?? 'unavailable'} | ${sample.status}${sample.failures.length ? `: ${sample.failures.join(', ')}` : ''} |`)
            lines.push('', '## 冻结共享订阅身份', '', '| Sample | 已验证 | 请求方 hash | 订阅付费方 hash | 访问类型 | Profile version / digest |',
              '|---|---|---|---|---|---|')
            for (const sample of formal.cases) {
              const shared = sample.sharedSubscription
              lines.push(`| ${sample.sampleId} | ${shared.verified} | ${shared.requesterHash ?? 'unavailable'} | ${shared.payerHash ?? 'unavailable'} | ${shared.access ?? 'unavailable'} | ${shared.profileVersion ?? 'unavailable'} / ${shared.profileDigest ?? 'unavailable'} |`)
            }
            lines.push('', '宿主鉴权判定范围为 daemon HttpServerLink/taskFetch 的鉴权/代理入口，结合固定 worker 的 MCP 两类业务 fetch 路径审计及本轮实际收到的MCP业务收据；claim内目录校验通过时，目录GET可以为0。它不表示全部 HTTP 已计数。子进程 generationCoverage=unverified、allFirstPartyHttpComplete=false；未收到的世代业务请求总量为 unavailable，缺 close 不会被改写成已完成。宿主声明的 remote MCP 配置须为 0；不把它外推成官方 CLI 任意 HOME/项目/插件网络的全量清单。',
              '', '| Sample | 宿主已观测 sends | MCP 目录 / 决策 / pending | 已观测配对完整 / child 终态完整 | 全世代业务总数 |', '|---|---:|---:|---|---|')
            for (const sample of formal.cases) {
              const child = sample.http.childBusiness
              lines.push(`| ${sample.sampleId} | ${sample.http.hostPhysicalSends ?? 'unavailable'} | ${child?.observedCatalogueSends ?? 'unavailable'} / ${child?.observedDecisionSends ?? 'unavailable'} / ${child?.pendingObservedSends ?? 'unavailable'} | ${child?.observedComplete ?? 'unavailable'} / ${child?.childLifecycleComplete ?? 'unavailable'} | unavailable |`)
            }
            lines.push('', '## 三次一组的原始值、median 与 max', '', '统计仅描述已观测值；completeCases 不足 3 的组不能通过。n=3 不估算 P95。',
              '', '| Harness | 完整轮数 / 3 | 真实 ACK 原始秒 | 真实 ACK median / max | stage median / max | 首 chunk median / max |', '|---|---:|---|---:|---:|---:|')
            for (const group of formal.groups) lines.push(`| ${group.harness} | ${group.completeCases} / 3 | ${group.dispatchToActualAckUpperBound.valuesMs.map(formalSeconds).join(', ')} | ${formalSeconds(group.dispatchToActualAckUpperBound.medianMs)} / ${formalSeconds(group.dispatchToActualAckUpperBound.maxMs)} | ${formalSeconds(group.dispatchToAgentStage.medianMs)} / ${formalSeconds(group.dispatchToAgentStage.maxMs)} | ${formalSeconds(group.dispatchToFirstProviderChunk.medianMs)} / ${formalSeconds(group.dispatchToFirstProviderChunk.maxMs)} |`)
            lines.push('', '## 每个已有版本检查点', '', '| Pin | UTC start | UTC finish | DPL | Worker | 状态 |', '|---:|---|---|---|---|---|')
            for (const pin of report.versionPins ?? []) lines.push(`| ${pin.sequence} | ${pin.startedAt ?? 'unavailable'} | ${pin.finishedAt ?? 'unavailable'} | ${pin.deploymentId ?? 'unavailable'} | ${pin.workerRelease?.workerSha ?? 'unavailable'} | ${pin.status}${pin.reason ? `: ${pin.reason}` : ''} |`)
            lines.push('', '## 必要阶段完整性', '', '以下只要求本轮全新仓库任务的正常派生模板路径。安装/旧 VM 升级/question recovery 不属于必需阶段。父子与并行时长重叠，不能跨行相加；claim 凭据准备与 assignment_context / credentials_wait 尤其如此。',
              '', '预热收据使用独立的预热起点：daemon.adapter.preparation 与 daemon.preparation.* 含等待 checkout 的时间，可与 repository 和晚期 adapter.start 重叠，不能相加。相同阶段只在各自收据内取区间并集；早期 cli_init 不写入晚期 daemon.adapter.cli_init。两条路径都必须由固定 checkout 的 hasStartupInitialization 验证真实成功的 cli_init；缺失或无效收据不补 0，也不回退掩盖。',
              '', '| Sample | 初始化证据来源 | Claim 认证来源 | 官方观测认证来源 | cli_init 秒 | 预热开始 UTC | 预热结束 UTC | 预热总秒 |', '|---|---|---|---|---:|---|---|---:|')
            for (const sample of formal.cases) lines.push(`| ${sample.sampleId} | ${sample.stages.initialization?.source ?? 'unavailable'} | ${sample.stages.preparation?.claimAuthentication ?? 'unavailable'} | ${sample.stages.preparation?.observedAuthSource ?? 'unavailable'} | ${formalSeconds(sample.stages.initialization?.ms)} | ${sample.stages.preparation ? new Date(sample.stages.preparation.startedAt).toISOString() : 'unavailable'} | ${sample.stages.preparation ? new Date(sample.stages.preparation.endedAt).toISOString() : 'unavailable'} | ${formalSeconds(sample.stages.preparation?.ms)} |`)
            const stageNames = [...new Set(formal.cases.flatMap(sample => Object.keys(sample.stages.valuesMs)))].sort()
            lines.push('', `| 阶段（秒） | ${formal.cases.map(sample => sample.sampleId).join(' | ')} |`, `|---|${formal.cases.map(() => '---:|').join('')}`)
            for (const name of stageNames) lines.push(`| ${name} | ${formal.cases.map(sample => formalSeconds(sample.stages.valuesMs[name])).join(' | ')} |`)
            lines.push('', '安装分支依据为已发布模板目录、精确版本 pin 与固定源码中仅官方 bare-template 调用 bootstrap 的条件；这不是通过缺日志推得的 0ms。当前安全收据不带逐 VM template ID，因此逐 VM 安装时长未观测时仍记 unavailable。实际 bootstrap 记录如出现，会作为分支异常使本轮失败。',
              '', '| Sample | start/finish 与必需阶段 | 缺失 | bootstrap 观测条数 / 秒 |', '|---|---|---|---|')
            for (const sample of formal.cases) lines.push(`| ${sample.sampleId} | ${sample.stages.status} | ${sample.stages.missing.join(', ') || 'none'} | ${sample.stages.installation.observedBootstrapRecords} / ${formalSeconds(sample.stages.installation.measuredMs)} |`)
            lines.push('', '## 资源、数据库与费用口径', '',
              `请求的全新任务 ${formal.resources.requestedFreshTasks} 个；已观测 sandbox create 日志 ${formal.resources.sandboxCreateSpanRecords} 条；主 run machine end 成功确认 ${formal.resources.primaryRunMachineEndConfirmed} 个；自有测试 issue 删除确认 ${formal.resources.testIssueDeletionConfirmed} 个。这些是操作收据，不是 provider 账单或独立资源清单。`,
              '', 'HTTP 记录只表示上述明确范围的实际发送，不是全部业务 HTTP 总数，也不等于 SQL 次数、数据库传输字节或美元。完整逐 run APP DB 数据：unavailable；未用采样外推为实际数。官方 provider OTLP 是 best_effort、flush=not_confirmed，观测事件数不代表完整 provider 总调用数。',
              '', '新增计算归属冻结执行身份绑定的 E2B 账号；模型使用现有官方 Claude/Codex 订阅；编排使用现有 Mikka 基础设施。没有创建额外订阅。',
              '', '本附件未保留实际 VM CPU/内存及 running 秒数，所以本批实际计算时长与费用估算均为 unavailable。仅作费率参考：2 vCPU / 4 GiB 为 $0.000046/运行秒（$0.1656/运行小时）；paused/killed 不计运行费。将来只有拿到实际配置与运行时长后才可计算估算，且不包含既有套餐、模型订阅与编排费用，也不冒充账单。',
              '', '费率来源：[E2B pricing](https://e2b.dev/pricing)、[E2B calculate sandbox price](https://docs.e2b.dev/faq/calculate-sandbox-price)。任务 VM 的暂停由实际 safePoint 与生命周期处理决定；本批 finally 清理通过正常 owner end 回执和当前 run 链机器视图确认回收，15 分钟超时策略不代替该确认。',
              '', '## 原始 driver 分段与 HTTP 明细', '', '下方保留原 driver 的观测结果；正式结论以前面的独立证据判定为准。', '')
            if (typeof detailMarkdown === 'function') lines.push(detailMarkdown(report).replace(/^## #1505 生产云启动测量\n/, '').replaceAll('—', 'unavailable'))
            return lines.join('\n') + '\n'
          }
          // END OFFLINE FORMAL REPORT
          const commit=process.env.EXPECTED_APP_COMMIT;
          if(!/^[a-f0-9]{40}$/.test(commit??''))throw Error('baseline_expected_deployment_missing');
          const release=await readProductionWorkerRelease({token:process.env.VERCEL_TEAM_TOKEN});
          if(release.workerSha!==process.env.EXPECTED_WORKER_SHA||release.sourceCommit!==process.env.EXPECTED_WORKER_SOURCE
            ||JSON.stringify(release.templates)!==JSON.stringify({desktop:process.env.EXPECTED_TEMPLATE_DESKTOP,claude:process.env.EXPECTED_TEMPLATE_CLAUDE,codex:process.env.EXPECTED_TEMPLATE_CODEX}))throw Error('acceptance_worker_pin_mismatch');
          // Use the independently prepared dedicated Bot/window. The strict
          // driver selects the normal SMOKE team and creates its normal shared Profiles.
          const expectedDiagnosticWindow=diagnosticWindowPins(process.env);
          const options=parseOptions(['--runs','6','--harness','both','--mode','acceptance','--strategy',process.env.ACCEPTANCE_STRATEGY,'--runtime-evidence','required','--official-timing','enabled','--expected-build',commit,'--revision',commit,
            '--expected-worker-sha',process.env.EXPECTED_WORKER_SHA,'--expected-worker-source',process.env.EXPECTED_WORKER_SOURCE,'--max-startup-ms','5000','--timeout-ms','240000','--bot-id',expectedDiagnosticWindow.botId],{});
          const versionPins=[];
          const expectedDeploymentId=process.env.EXPECTED_DEPLOYMENT_ID;
          const expectedRelease={workerSha:process.env.EXPECTED_WORKER_SHA,sourceCommit:process.env.EXPECTED_WORKER_SOURCE,
            templates:{desktop:process.env.EXPECTED_TEMPLATE_DESKTOP,claude:process.env.EXPECTED_TEMPLATE_CLAUDE,codex:process.env.EXPECTED_TEMPLATE_CODEX}};
          // This hook runs only inside the driver's existing initial, before/after
          // each sample, and final pins. No independent timer or production DB read.
          const readPinnedWorkerRelease=async()=>{
            const pin={sequence:versionPins.length+1,startedAt:new Date().toISOString(),expectedDeploymentId};
            let reason='control_plane_unavailable';
            try{
              const rawAlias=await api(`/v4/aliases/${PRODUCTION_ALIAS}`,{token:process.env.VERCEL_TEAM_TOKEN});
              reason='alias_invalid';
              const alias=activeAlias(rawAlias);
              pin.deploymentId=alias.deploymentId;pin.aliasUpdatedAt=new Date(alias.updatedAt).toISOString();
              reason='deployment_changed';
              if(alias.deploymentId!==expectedDeploymentId)throw Error('startup_worker_release_changed');
              reason='control_plane_unavailable';
              const current=await readProductionWorkerRelease({token:process.env.VERCEL_TEAM_TOKEN});
              pin.workerRelease=current;reason='runtime_tuple_changed';
              if(JSON.stringify(current)!==JSON.stringify(expectedRelease))throw Error('startup_worker_release_changed');
              reason='diagnostic_window_changed';
              pin.diagnosticWindow=await readDiagnosticWindowPin(expectedDiagnosticWindow,{projectId:PROJECT,
                api:path=>api(path,{token:process.env.VERCEL_TEAM_TOKEN})});
              pin.status='passed';return current;
            }catch{
              pin.status='failed';pin.reason=reason;
              // Reuse the driver's closed version-drift code: abort the batch,
              // preserve its owned sample, run cleanup, and collect its logs.
              throw Error('startup_worker_release_changed');
            }finally{pin.finishedAt=new Date().toISOString();versionPins.push(pin)}
          };
          const report=await runCloudStartup(options,{readWorkerRelease:readPinnedWorkerRelease});
          report.versionPins=versionPins;
          report.diagnosticWindowExpected={...expectedDiagnosticWindow,helperCommit:process.env.DIAGNOSTIC_HELPER_COMMIT,helperSha256:process.env.DIAGNOSTIC_HELPER_SHA256};
          const bracketed=report.samples.length===6
            &&versionPins.length===14&&versionPins.every(pin=>pin.status==='passed');
          report.versionPinCoverage={status:bracketed?'complete':'incomplete',source:'existing_driver_pin_hook',expectedChecks:14,observedChecks:versionPins.length};
          if(bracketed)for(let i=0;i<report.samples.length;i++)report.samples[i].versionPins={before:versionPins[1+i*2],after:versionPins[2+i*2]};
          else{report.error??='startup_version_pin_coverage_incomplete';report.status='failed'}
          report.workflow={repository:process.env.GITHUB_REPOSITORY,runId:process.env.GITHUB_RUN_ID,commit:process.env.GITHUB_SHA,
            sourceCommit:process.env.ACCEPTANCE_SOURCE_COMMIT,sourceTree:process.env.ACCEPTANCE_SOURCE_TREE};
          await mkdir('acceptance-results',{recursive:true});
          await writeFile('acceptance-results/cloud-startup-acceptance.json',JSON.stringify(report,null,2)+'\n',{mode:0o600});
          try {
            await collectProductionTimings(report,{token:process.env.VERCEL_TEAM_TOKEN,deploymentId:process.env.EXPECTED_DEPLOYMENT_ID});
          } finally {
            finalizeAcceptanceReport(report,{expectedBuild:commit,expectedDeploymentId,expectedRelease,expectedDiagnosticWindow,
              verifyStartupInitialization:hasStartupInitialization,
              verifyRuntimeEvidence:sample=>runtimeEvidence(readRuntimeTiming(sample.runtimeTiming,sample),{requireOfficial:true})});
            await writeFile('acceptance-results/cloud-startup-acceptance.json',JSON.stringify(report,null,2)+'\n',{mode:0o600});
            await writeFile('acceptance-results/cloud-startup-acceptance.md',renderAcceptanceMarkdown(report,markdown),{mode:0o600});
          }
          console.log(JSON.stringify({status:report.status,applicationBuild:report.build,revision:report.revision,workerRelease:report.workerRelease,
            team:report.team,accountHash:report.accountHash,officialTiming:report.officialTiming,
            versionPins:report.versionPins,versionPinCoverage:report.versionPinCoverage,
            formalAcceptance:{status:report.formalAcceptance.status,reasons:report.formalAcceptance.reasons,
              groups:report.formalAcceptance.groups,logCollectionComplete:report.formalAcceptance.logCollectionComplete,
              pinCoverageComplete:report.formalAcceptance.pinCoverageComplete},
            serverLogCollection:report.serverLogCollection,summary:report.summary,
            samples:report.samples.map(sample=>({sampleId:sample.sampleId,status:sample.status,error:sample.error,dispatchRefusal:sample.dispatchRefusal,issueId:sample.issueId,runId:sample.runId,
              workflowRunId:sample.workflowRunId,runIdHash:sample.runIdHash,requestTraceId:sample.requestTraceId,harness:sample.harness,
              agentStart:sample.agentStart,firstProviderChunk:sample.firstProviderChunk,stages:sample.stages,daemonStartupTiming:sample.daemonStartupTiming,
              daemonPreparationTiming:sample.daemonPreparationTiming,preparationTimingStatus:sample.preparationTimingStatus,
              execution:sample.execution,toolCalls:sample.toolCalls,replyVerified:sample.replyVerified,requireReplyAfterTool:sample.requireReplyAfterTool,
              replyVerifiedAfterTool:sample.replyVerifiedAfterTool,cleanup:sample.cleanup,timing:sample.timing,
              serverStartupTimings:sample.serverStartupTimings,nativeProxyTimings:sample.nativeProxyTimings,nativeProviderCalls:sample.nativeProviderCalls,
              runtimeTiming:sample.runtimeTiming,runtimeEvidence:sample.runtimeEvidence}))}));
          if(report.status!=='passed'||report.formalAcceptance.status!=='passed')process.exitCode=1;
          JS
      - name: Remove only the exact prepared project diagnostic window
        if: always() && steps.source_ready.outcome == 'success' && steps.platform_token.outcome == 'success'
        run: |
          node --input-type=module <<'JS'
          import { mkdir, readFile, writeFile, appendFile } from 'node:fs/promises';
          import { removeOwnedWindow, SOURCE, TREE, PROJECT, TEAM, KEY } from './.acceptance-window-helper/scripts/ops/issue1505-diagnostic-window.mjs';
          const env=process.env;
          // These are reviewed target pins from the prepare receipt, not a newly fabricated creation receipt.
          const expected={version:1,issue:1505,sourceCommit:SOURCE,sourceTree:TREE,projectId:PROJECT,teamId:TEAM,
            window:{key:KEY,id:env.EXPECTED_DIAGNOSTIC_ENV_ID,valueSha256:env.EXPECTED_DIAGNOSTIC_VALUE_SHA256,expiresAt:env.EXPECTED_DIAGNOSTIC_EXPIRES_AT}};
          const codes=new Set(['cleanup_record_invalid','cleanup_window_changed','cleanup_absence_unconfirmed','platform_token_missing',
            'platform_transport_failed','platform_request_refused','platform_response_invalid']);
          let cleanup;
          try{cleanup={status:'passed',...await removeOwnedWindow(expected,{token:env.VERCEL_TEAM_TOKEN})};}
          catch(error){cleanup={status:'failed',code:codes.has(error?.windowCode)?error.windowCode:'diagnostic_window_cleanup_failed',
            key:KEY,id:expected.window.id,activeDeploymentRevoked:false,originalExpiresAt:expected.window.expiresAt};process.exitCode=1;}
          await mkdir('acceptance-results',{recursive:true});
          await writeFile('acceptance-results/diagnostic-window-cleanup.json',JSON.stringify(cleanup,null,2)+'\n',{mode:0o600});
          let report;
          try{report=JSON.parse(await readFile('acceptance-results/cloud-startup-acceptance.json','utf8'));}
          catch(error){if(error?.code!=='ENOENT')throw error;}
          if(report){
            report.diagnosticWindowCleanup=cleanup;
            if(cleanup.status!=='passed'){
              report.status='failed';report.cleanup.errors.push({step:'diagnostic_window_remove',code:cleanup.code});
              if(report.formalAcceptance){report.formalAcceptance.status='failed';report.formalAcceptance.reasons.push('diagnostic_window_cleanup_failed');}
              try{
                const priorMarkdown=await readFile('acceptance-results/cloud-startup-acceptance.md','utf8');
                await writeFile('acceptance-results/cloud-startup-acceptance.md',priorMarkdown.replace('独立证据判定：**passed**','独立证据判定：**failed**'),{mode:0o600});
              }catch(error){if(error?.code!=='ENOENT')throw error;}
            }
            await writeFile('acceptance-results/cloud-startup-acceptance.json',JSON.stringify(report,null,2)+'\n',{mode:0o600});
            await appendFile('acceptance-results/cloud-startup-acceptance.md',`\n## 诊断窗口配置收尾\n\n${cleanup.status==='passed'?'精确项目配置已删除，ID 404 与同 key 缺席均已回读。':'配置清理未确认，保留目标身份供后续恢复；整批不能通过。'} 删除项目配置不撤销活动 DPL 的既有环境；expiresAt=${cleanup.originalExpiresAt} 仍是该 DPL 停止开启新诊断任务的期限。\n`);
          }
          console.log(JSON.stringify(cleanup));
          JS
      - name: Upload only the sanitized measurement report
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: issue-1505-startup-acceptance
          path: |
            acceptance-results/cloud-startup-acceptance.json
            acceptance-results/cloud-startup-acceptance.md
            acceptance-results/diagnostic-window-cleanup.json
            acceptance-results/deployment-pin.json
            acceptance-results/function-regions.json
            ${{ runner.temp }}/issue1505-upstream-release-wait.json
          if-no-files-found: warn
          retention-days: 7

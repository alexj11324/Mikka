# Prepared only. Root must verify the fixed APP source and the exact runtime's
# dual subscription proof and public tuple. Resolve the production alias once
# under the held Web lock; all READY/source/tuple checks still precede models.
name: Issue 1505 strict production startup acceptance
on:
  push:
    branches: [ops/1505-preflight]
permissions:
  contents: read
concurrency:
  group: production-smoke-owner-acceptance
  cancel-in-progress: false
  queue: max
jobs:
  acceptance:
    if: github.repository == 'alexj11324/Mikka'
    runs-on: ubuntu-latest
    timeout-minutes: 40
    concurrency:
      group: web-deploy-production
      cancel-in-progress: false
      queue: max
    permissions:
      contents: read
      actions: read
      id-token: write
    env:
      ACCEPTANCE_SOURCE_COMMIT: e33e3a91d4011efbe768b11b428a5d152ede744a
      ACCEPTANCE_SOURCE_TREE: b2e36d3351654fceec59fe138a55de31cb155df9
      EXPECTED_APP_COMMIT: 78c3c13d35c2c664113a140bccb3db4ae9606021
      EXPECTED_DEPLOYMENT_ID: RESOLVE_ONCE_FROM_PRODUCTION_ALIAS
      EXPECTED_WORKER_SHA: fe20477b6b42416f6a53fbbd2a7efc1c9cfb1dea
      EXPECTED_WORKER_SOURCE: 0479675e188efeac341b207d8616c4d7b9d4ee23
      EXPECTED_TEMPLATE_DESKTOP: p2pjujpb74f7fi53ze7y
      EXPECTED_TEMPLATE_CLAUDE: e8853ntj54nfz72gdvia
      EXPECTED_TEMPLATE_CODEX: k34g6jozduq3in302l1j
      ACCEPTANCE_STRATEGY: derived
      EXPECTED_DIAGNOSTIC_BOT_ID: fdeea45f-8cb2-450a-96a4-d9a682f71482
      EXPECTED_DIAGNOSTIC_ENV_ID: 5U3cbUROL36c7e4z
      EXPECTED_DIAGNOSTIC_VALUE_SHA256: 4627f203887af0e2e5904e43afca89ebf6241f55ce998aa5200ef65df6b4ce67
      EXPECTED_DIAGNOSTIC_EXPIRES_AT: 2026-11-08T02:23:36.365Z
      DIAGNOSTIC_HELPER_COMMIT: 5958dea38437de20512bbbdf60b940ccc83f00ff
      DIAGNOSTIC_HELPER_SHA256: 46d8b905518cf480fecdf0a3bce1a3863f4e79c92609b1cd3ec9d4231820898c
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.ACCEPTANCE_SOURCE_COMMIT }}
          persist-credentials: false
      - name: Check out only the reviewed diagnostic-window cleanup helper
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ env.DIAGNOSTIC_HELPER_COMMIT }}
          path: .acceptance-window-helper
          persist-credentials: false
      - name: Await the exact upstream runtime and cleanup before credentials
        id: upstream_release
        timeout-minutes: 6
        env:
          GITHUB_TOKEN: ${{ github.token }}
        run: |
          node --input-type=module <<'JS'
          // BEGIN UPSTREAM RELEASE WAIT GUARD
          // Read-only external GitHub metadata. No application, account, database, or VM I/O.
          const UPSTREAM_RELEASE = Object.freeze({
            repository: 'alexj11324/Mikka', runId: 42423534091, runAttempt: 1,
            sourceCommit: '0479675e188efeac341b207d8616c4d7b9d4ee23',
            event: 'push', branch: 'main', path: '.github/workflows/e2b-official-runtime.yml',
          })
          const UPSTREAM_JOBS = Object.freeze(['test', 'check', 'validate / build', 'await-web',
            'subscriptions', 'publish / deploy', 'cleanup'])
          const UPSTREAM_RUN_PATH = `/repos/${UPSTREAM_RELEASE.repository}/actions/runs/${UPSTREAM_RELEASE.runId}`
          const UPSTREAM_JOBS_PATH = `${UPSTREAM_RUN_PATH}/attempts/${UPSTREAM_RELEASE.runAttempt}/jobs?per_page=100`
          const UPSTREAM_STATES = new Set(['queued', 'in_progress', 'completed', 'waiting', 'pending', 'requested'])
          const UPSTREAM_CONCLUSIONS = new Set(['success', 'failure', 'neutral', 'cancelled', 'skipped', 'timed_out',
            'action_required', 'stale', 'startup_failure'])
          class UpstreamReleaseError extends Error {
            constructor(code, cause) { super(code, cause === undefined ? undefined : { cause }); this.code = code }
          }
          function upstreamRequire(condition, code) {
            if (!condition) throw new UpstreamReleaseError(code)
          }
          function upstreamStatus(record) {
            upstreamRequire(record && UPSTREAM_STATES.has(record.status)
              && (record.status === 'completed' ? UPSTREAM_CONCLUSIONS.has(record.conclusion) : record.conclusion === null),
            'upstream_metadata_invalid')
          }
          function upstreamRun(record) {
            upstreamRequire(record?.id === UPSTREAM_RELEASE.runId && record.run_attempt === UPSTREAM_RELEASE.runAttempt
              && record.head_sha === UPSTREAM_RELEASE.sourceCommit && record.head_branch === UPSTREAM_RELEASE.branch
              && record.event === UPSTREAM_RELEASE.event && record.path === UPSTREAM_RELEASE.path
              && record.repository?.full_name === UPSTREAM_RELEASE.repository, 'upstream_identity_mismatch')
            upstreamStatus(record)
          }
          function upstreamJobs(record) {
            upstreamRequire(Array.isArray(record?.jobs) && record.total_count === record.jobs.length
              && record.jobs.length <= UPSTREAM_JOBS.length, 'upstream_jobs_invalid')
            const ids = new Set(), names = new Set()
            for (const job of record.jobs) {
              upstreamRequire(Number.isSafeInteger(job.id) && job.id > 0 && !ids.has(job.id)
                && UPSTREAM_JOBS.includes(job.name) && !names.has(job.name)
                && job.run_id === UPSTREAM_RELEASE.runId && job.run_attempt === UPSTREAM_RELEASE.runAttempt
                && job.head_sha === UPSTREAM_RELEASE.sourceCommit && job.head_branch === UPSTREAM_RELEASE.branch,
              'upstream_job_identity_mismatch')
              upstreamStatus(job); ids.add(job.id); names.add(job.name)
            }
            return record.jobs.map(({ id, name, status, conclusion }) => ({ id, name, status, conclusion }))
              .sort((a, b) => UPSTREAM_JOBS.indexOf(a.name) - UPSTREAM_JOBS.indexOf(b.name))
          }
          function githubMetadataReader(token, fetchMetadata = fetch) {
            return async (path, remainingMs) => {
              upstreamRequire(path === UPSTREAM_RUN_PATH || path === UPSTREAM_JOBS_PATH, 'upstream_metadata_path_invalid')
              upstreamRequire(typeof token === 'string' && token.length > 0, 'upstream_guard_environment_invalid')
              const signal = AbortSignal.timeout(Math.max(1, Math.ceil(remainingMs)))
              try {
                const response = await fetchMetadata(`https://api.github.com${path}`, { method: 'GET', redirect: 'error', signal,
                  headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'X-GitHub-Api-Version': '2022-11-28' } })
                upstreamRequire(response.status === 200, 'upstream_metadata_http_failed')
                const value = await response.json()
                upstreamRequire(!signal.aborted, 'upstream_wait_timeout')
                return value
              } catch (cause) {
                if (signal.aborted) throw new UpstreamReleaseError('upstream_wait_timeout', cause)
                if (cause instanceof UpstreamReleaseError) throw cause
                throw new UpstreamReleaseError('upstream_metadata_request_failed', cause)
              }
            }
          }
          async function waitForUpstreamRelease({ readJson, beforeRead = () => {},
            pause = ms => new Promise(resolve => setTimeout(resolve, ms)),
            monotonic = () => performance.now(), wallClock = Date.now, maxWaitMs = 300_000 }) {
            const started = monotonic(), deadline = started + maxWaitMs
            const receipt = { version: 1, scope: 'exact_upstream_runtime_completion_only', upstream: UPSTREAM_RELEASE,
              requiredJobs: UPSTREAM_JOBS, maxWaitMs, pollIntervalMs: 5000, startedAt: new Date(wallClock()).toISOString(),
              status: 'waiting', observations: 0, metadataReadAttempts: 0, runStatus: null, runConclusion: null, jobs: [] }
            const remaining = () => Math.max(0, deadline - monotonic())
            const get = async path => {
              upstreamRequire(remaining() > 0, 'upstream_wait_timeout')
              receipt.metadataReadAttempts += 1
              let value
              try { value = await readJson(path, remaining()) }
              catch (cause) {
                if (remaining() === 0) throw new UpstreamReleaseError('upstream_wait_timeout', cause)
                if (cause instanceof UpstreamReleaseError) throw cause
                throw new UpstreamReleaseError('upstream_metadata_request_failed', cause)
              }
              upstreamRequire(remaining() > 0, 'upstream_wait_timeout')
              return value
            }
            const observeRun = run => {
              upstreamRun(run); receipt.runStatus = run.status; receipt.runConclusion = run.conclusion
              upstreamRequire(run.status !== 'completed' || run.conclusion === 'success', 'upstream_run_failed')
            }
            try {
              upstreamRequire(Number.isFinite(maxWaitMs) && maxWaitMs > 0 && maxWaitMs <= 300_000,
                'upstream_guard_environment_invalid')
              beforeRead()
              while (true) {
                const run = await get(UPSTREAM_RUN_PATH)
                observeRun(run)
                receipt.jobs = upstreamJobs(await get(UPSTREAM_JOBS_PATH)); receipt.observations += 1
                upstreamRequire(receipt.jobs.every(job => job.status !== 'completed' || job.conclusion === 'success'),
                  'upstream_job_failed')
                if (run.status === 'completed') {
                  upstreamRequire(receipt.jobs.length === UPSTREAM_JOBS.length
                    && receipt.jobs.every(job => job.status === 'completed' && job.conclusion === 'success'),
                  'upstream_jobs_incomplete')
                  // Re-read the run after the attempt-specific jobs; a newly started rerun is not this proof.
                  const finalRun = await get(UPSTREAM_RUN_PATH)
                  observeRun(finalRun)
                  upstreamRequire(finalRun.status === 'completed', 'upstream_metadata_invalid')
                  receipt.status = 'passed'; break
                }
                upstreamRequire(remaining() > 0, 'upstream_wait_timeout')
                await pause(Math.min(5000, remaining()))
              }
            } catch (error) {
              receipt.status = 'failed'
              receipt.code = error instanceof UpstreamReleaseError ? error.code : 'upstream_guard_internal_error'
            }
            receipt.finishedAt = new Date(wallClock()).toISOString()
            receipt.waitMs = Math.round((monotonic() - started) * 1000) / 1000
            return receipt
          }
          // END UPSTREAM RELEASE WAIT GUARD
          
          import { writeFile } from 'node:fs/promises'
          import { join } from 'node:path'
          const receipt = await waitForUpstreamRelease({ readJson: githubMetadataReader(process.env.GITHUB_TOKEN), beforeRead: () => {
            upstreamRequire(process.env.GITHUB_REPOSITORY === UPSTREAM_RELEASE.repository
              && typeof process.env.GITHUB_TOKEN === 'string' && process.env.GITHUB_TOKEN.length > 0,
            'upstream_guard_environment_invalid')
          } })
          try {
            await writeFile(join(process.env.RUNNER_TEMP, 'issue1505-upstream-release-wait.json'),
              JSON.stringify(receipt, null, 2) + '\n', { mode: 0o600 })
          } catch {
            console.error(JSON.stringify({ status: 'failed', code: 'upstream_receipt_write_failed' }))
            process.exitCode = 1
          }
          console.log(JSON.stringify(receipt))
          if (receipt.status !== 'passed') process.exitCode = 1
          JS
      - name: Verify the exact merged acceptance source
        id: source_ready
        run: |
          test "$(git rev-parse HEAD)" = "$ACCEPTANCE_SOURCE_COMMIT"
          test "$(git rev-parse HEAD^{tree})" = "$ACCEPTANCE_SOURCE_TREE"
          test "$(git -C .acceptance-window-helper rev-parse HEAD)" = "$DIAGNOSTIC_HELPER_COMMIT"
          node --input-type=module <<'JS'
          import assert from 'node:assert/strict';
          import { readFileSync } from 'node:fs';
          import { createHash } from 'node:crypto';
          const env=process.env;
          assert.match(env.EXPECTED_DIAGNOSTIC_BOT_ID??'',/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i);
          assert.match(env.EXPECTED_DIAGNOSTIC_ENV_ID??'',/^[A-Za-z0-9_-]{1,200}$/);assert.ok(!env.EXPECTED_DIAGNOSTIC_ENV_ID.startsWith('READY_'));
          assert.match(env.EXPECTED_DIAGNOSTIC_VALUE_SHA256??'',/^[a-f0-9]{64}$/);
          assert.ok(Number.isFinite(Date.parse(env.EXPECTED_DIAGNOSTIC_EXPIRES_AT)));
          assert.ok(Date.parse(env.EXPECTED_DIAGNOSTIC_EXPIRES_AT)-Date.now()>=45*60_000,'acceptance_diagnostic_window_budget_insufficient');
          assert.match(env.DIAGNOSTIC_HELPER_COMMIT??'',/^[a-f0-9]{40}$/);assert.match(env.DIAGNOSTIC_HELPER_SHA256??'',/^[a-f0-9]{64}$/);
          assert.equal(createHash('sha256').update(readFileSync('.acceptance-window-helper/scripts/ops/issue1505-diagnostic-window.mjs')).digest('hex'),env.DIAGNOSTIC_HELPER_SHA256);
          JS
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: 24
      - name: Read the existing SMOKE shared-team acceptance account
        uses: Infisical/secrets-action@d2e351f16c6ca20d17c85e6c992e04bdeb64e87d
        with:
          method: oidc
          identity-id: 2cf9fa19-b9db-4c08-8ca0-b31859f2cbac
          oidc-audience: mikka-infisical
          project-id: 89850d6a-f020-4936-863e-df77380dfe40
          env-slug: prod
          secret-path: /
          recursive: false
          include-imports: false
      - name: Read the existing token for version checks and exact owned-window cleanup
        id: platform_token
        uses: Infisical/secrets-action@d2e351f16c6ca20d17c85e6c992e04bdeb64e87d
        with:
          method: oidc
          identity-id: 2cf9fa19-b9db-4c08-8ca0-b31859f2cbac
          oidc-audience: mikka-infisical
          project-id: 89850d6a-f020-4936-863e-df77380dfe40
          env-slug: prod
          secret-path: /platform
          secret-name: VERCEL_TEAM_TOKEN
          include-imports: false
      - name: Check the exact production tuple and log access before dispatch
        run: |
          node --input-type=module <<'JS'
          import assert from 'node:assert/strict';
          import { api, activeAlias, PRODUCTION_ALIAS, PROJECT, TEAM } from './scripts/ops/deployment-regression.mjs';
          import { appendFile, mkdir, writeFile } from 'node:fs/promises';
          import { readProductionWorkerRelease,createSessionClient } from './scripts/acceptance/cloud-startup.mjs';
          const env=process.env,commit=env.EXPECTED_APP_COMMIT;
          for(const key of ['EXPECTED_APP_COMMIT','EXPECTED_WORKER_SHA','EXPECTED_WORKER_SOURCE'])assert.match(env[key]??'',/^[a-f0-9]{40}$/,'unfilled_ready_pin');
          assert.equal(env.EXPECTED_DEPLOYMENT_ID,'RESOLVE_ONCE_FROM_PRODUCTION_ALIAS','deployment_pin_must_resolve_once');
          assert.ok(['derived','pool','combined'].includes(env.ACCEPTANCE_STRATEGY),'strategy_invalid');
          const templates={desktop:env.EXPECTED_TEMPLATE_DESKTOP,claude:env.EXPECTED_TEMPLATE_CLAUDE,codex:env.EXPECTED_TEMPLATE_CODEX};
          for(const [kind,id] of Object.entries(templates)){
            assert.match(id??'',/^[A-Za-z0-9_-]{1,100}$/,'template_pin_invalid');assert.ok(!id.startsWith('READY_'),'unfilled_template_pin');
            if(env.ACCEPTANCE_STRATEGY==='derived')assert.notEqual(id,kind,'derived_template_required');
          }
          const release=await readProductionWorkerRelease({token:env.VERCEL_TEAM_TOKEN});
          assert.deepEqual(release,{workerSha:env.EXPECTED_WORKER_SHA,sourceCommit:env.EXPECTED_WORKER_SOURCE,templates},'production_release_mismatch');
          const alias=activeAlias(await api(`/v4/aliases/${PRODUCTION_ALIAS}`,{token:env.VERCEL_TEAM_TOKEN}));
          const aliasReadAt=new Date().toISOString(),expectedDeploymentId=alias.deploymentId;
          const deployment=await api(`/v13/deployments/${expectedDeploymentId}`,{token:env.VERCEL_TEAM_TOKEN});
          assert.equal(deployment.id??deployment.uid,expectedDeploymentId,'deployment_id_mismatch');
          assert.equal(deployment.readyState,'READY');assert.equal(deployment.target,'production');
          assert.equal(deployment.gitSource?.sha??deployment.meta?.githubCommitSha,commit,'deployment_source_mismatch');
          // Insert immediately after the existing READY/production/source checks.
          // This copies only already-read public metadata. Failure is diagnostic-only.
          try {
            const { writeFile } = await import('node:fs/promises');
            const { join } = await import('node:path');
            const regions = Array.isArray(deployment.regions) && deployment.regions.length <= 64 &&
              deployment.regions.every(value => typeof value === 'string' && /^[a-z]{3}[1-9][0-9]?$/.test(value))
              ? deployment.regions : null;
            await writeFile(join(env.RUNNER_TEMP, 'issue1505-deployment-regions.json'),
              JSON.stringify({ deploymentId: /^dpl_[A-Za-z0-9]+$/.test(deployment.id ?? '') ? deployment.id : null,
                sourceCommit: commit, regions }) + '\n', { mode: 0o600 });
          } catch { console.log('function_regions_metadata_handoff_unavailable'); }
          const client=createSessionClient('https://app.aspectlylabs.com');
          assert.equal((await client.json('/api/version')).build,commit,'public_build_mismatch');client.clear();
          const end=new Date(),start=new Date(end.getTime()-60000);
          const logs=await api('/v1/observability/events',{token:env.VERCEL_TEAM_TOKEN,
            headers:{'x-vercel-observability-query-reason':'cli/logs-runtime'},body:{event:'vercel.log',scope:{ownerId:TEAM,projectIds:[PROJECT]},
            timeRange:{start:start.toISOString(),end:end.toISOString()},select:['deploymentId','environment','message','truncated'],
            order:'desc',limit:1,filter:`deploymentId:"${expectedDeploymentId}" AND environment:production AND (dispatch_timing OR cloud_startup_timing OR subscription_native_timing)`}});
          assert.ok(Array.isArray(logs.events)&&typeof logs.pagination?.hasMore==='boolean','logs_contract_invalid');
          const pinKeys=['ACCEPTANCE_SOURCE_COMMIT','ACCEPTANCE_SOURCE_TREE','EXPECTED_APP_COMMIT','EXPECTED_DEPLOYMENT_ID',
            'EXPECTED_WORKER_SHA','EXPECTED_WORKER_SOURCE','EXPECTED_TEMPLATE_DESKTOP','EXPECTED_TEMPLATE_CLAUDE','EXPECTED_TEMPLATE_CODEX',
            'EXPECTED_DIAGNOSTIC_BOT_ID','EXPECTED_DIAGNOSTIC_ENV_ID','EXPECTED_DIAGNOSTIC_VALUE_SHA256','EXPECTED_DIAGNOSTIC_EXPIRES_AT',
            'DIAGNOSTIC_HELPER_COMMIT','DIAGNOSTIC_HELPER_SHA256'];
          const pins=Object.fromEntries(pinKeys.map(key=>[key,key==='EXPECTED_DEPLOYMENT_ID'?expectedDeploymentId:env[key]]));
          for(const value of Object.values(pins))assert.equal(typeof value,'string','deployment_pin_value_missing');
          const deploymentPin={version:1,status:'preflight_passed',source:'production_alias_resolve_once',fixedAt:new Date().toISOString(),
            alias:{hostname:alias.hostname,projectId:PROJECT,deploymentId:alias.deploymentId,updatedAt:alias.updatedAt,readAt:aliasReadAt},
            deployment:{id:expectedDeploymentId,sourceCommit:commit,readyState:deployment.readyState,target:deployment.target},pins};
          await mkdir('acceptance-results',{recursive:true});
          await writeFile('acceptance-results/deployment-pin.json',JSON.stringify(deploymentPin,null,2)+'\n',{mode:0o600,flag:'wx'});
          await appendFile(env.GITHUB_ENV,`EXPECTED_DEPLOYMENT_ID=${expectedDeploymentId}\n`);
          console.log(JSON.stringify({productionReadyTuple:'verified',build:commit,deploymentId:expectedDeploymentId,release,logs:'accepted'}));
          JS
      # Insert after the existing exact production preflight and before dispatch.
      # This is supplementary evidence; it never changes formal verdict.
      - name: Record function deployment regions (diagnostic only)
        timeout-minutes: 1
        continue-on-error: true
        run: |
          node --input-type=module <<'JS'
          import { mkdir, readFile, writeFile } from 'node:fs/promises';
          import { join } from 'node:path';
          import { api } from './scripts/ops/deployment-regression.mjs';
          // Diagnostic only. No acceptance decision, application request or database access.
          const object = value => value !== null && typeof value === 'object' && !Array.isArray(value)
          const deploymentId = value => typeof value === 'string' && /^dpl_[A-Za-z0-9]+$/.test(value)
          const sourceCommit = value => typeof value === 'string' && /^[a-f0-9]{40}$/.test(value)
          const regionList = value => Array.isArray(value) && value.length > 0 && value.length <= 64 &&
            value.every(region => typeof region === 'string' && /^[a-z]{3}[1-9][0-9]?$/.test(region))
            ? [...new Set(value)].sort() : null
          const functionPath = value => typeof value === 'string' && value.length > 0 && value.length <= 1024 &&
            /^[A-Za-z0-9_./[\]()+@:-]+$/.test(value) ? value : null
          
          function projectFunctionRegions({ expectedDeploymentId, expectedAppCommit, deployment, builds }) {
            const matched = object(deployment) && deployment.deploymentId === expectedDeploymentId &&
              deployment.sourceCommit === expectedAppCommit
            const result = {
              version: 1, diagnosticOnly: true, evidenceKind: 'function_deployment_placement',
              deploymentId: deploymentId(expectedDeploymentId) ? expectedDeploymentId : null,
              expectedAppCommit: sourceCommit(expectedAppCommit) ? expectedAppCommit : null,
              deploymentRegions: matched ? regionList(deployment.regions) : null,
              deploymentRegionsSource: matched ? 'existing_verified_preflight_get' : null,
              status: 'unknown', reason: 'builds_unavailable', functions: [],
              buildCount: null, lambdaCount: 0, malformedCount: 0,
              allLambdaFunctionsOnlyInCle1: null,
              invocationRegion: 'unknown', databaseEndpointMapping: 'unknown',
            }
            if (!object(builds) || !Array.isArray(builds.builds) || builds.builds.length > 1024) return result
            result.buildCount = builds.builds.length
            for (const build of builds.builds) {
              if (!object(build) || !Array.isArray(build.output)) { result.malformedCount++; continue }
              for (const output of build.output) {
                if (!object(output) || typeof output.type !== 'string') { result.malformedCount++; continue }
                if (output.type !== 'lambda') continue
                const path = functionPath(output.path)
                const deployedTo = object(output.lambda) ? regionList(output.lambda.deployedTo) : null
                result.functions.push({ path, deployedTo })
                if (path === null || deployedTo === null) result.malformedCount++
              }
            }
            result.lambdaCount = result.functions.length
            if (!result.lambdaCount) { result.reason = 'lambda_outputs_unavailable'; return result }
            result.status = result.malformedCount ? 'partial' : 'observed'
            result.reason = result.malformedCount ? 'function_output_incomplete' : null
            result.allLambdaFunctionsOnlyInCle1 = result.malformedCount ? null :
              result.functions.every(row => row.deployedTo.length === 1 && row.deployedTo[0] === 'cle1')
            return result
          }
          
          async function collectFunctionRegions({ expectedDeploymentId, expectedAppCommit, deployment, token, api }) {
            const base = projectFunctionRegions({ expectedDeploymentId, expectedAppCommit, deployment })
            if (!deploymentId(expectedDeploymentId) || !sourceCommit(expectedAppCommit)) {
              return { ...base, reason: 'pin_invalid', requestCount: 0, httpStatus: null }
            }
            if (typeof token !== 'string' || !token) return { ...base, reason: 'token_unavailable', requestCount: 0, httpStatus: null }
            try {
              // Existing api() adds teamId, forbids redirects, and applies its 20-second signal.
              // This is the only new request. No retry or second deployment GET.
              const builds = await api('/v11/deployments/' + expectedDeploymentId + '/builds', { token })
              return { ...projectFunctionRegions({ expectedDeploymentId, expectedAppCommit, deployment, builds }),
                requestCount: 1, httpStatus: null }
            } catch (error) {
              const message = error instanceof Error ? error.message : ''
              const status = /^vercel_api_http_([1-5][0-9]{2})$/.exec(message)?.[1]
              const reason = status ? 'http_error' : message === 'vercel_api_response_invalid' ? 'response_invalid' : 'request_unavailable'
              return { ...base, reason, requestCount: 1, httpStatus: status ? Number(status) : null }
            }
          }
          
          let deployment;
          try { deployment = JSON.parse(await readFile(join(process.env.RUNNER_TEMP, 'issue1505-deployment-regions.json'), 'utf8')); }
          catch { /* A missing/malformed local handoff leaves deploymentRegions unknown. */ }
          const report = await collectFunctionRegions({
            expectedDeploymentId: process.env.EXPECTED_DEPLOYMENT_ID,
            expectedAppCommit: process.env.EXPECTED_APP_COMMIT,
            deployment, token: process.env.VERCEL_TEAM_TOKEN, api,
          });
          report.observedAt = new Date().toISOString();
          await mkdir('acceptance-results', { recursive: true });
          await writeFile('acceptance-results/function-regions.json', JSON.stringify(report, null, 2) + '\n', { mode: 0o600 });
          // Do not print the original builds response, request headers or environment.
          console.log(JSON.stringify({ event: 'function_regions_observed', status: report.status,
            reason: report.reason, lambdaCount: report.lambdaCount, requestCount: report.requestCount }));
          JS
      - name: Accept three fresh repository starts on each official subscription
        run: |
          node --check scripts/acceptance/cloud-startup.mjs
          node --input-type=module <<'JS'
          import { mkdir, writeFile } from 'node:fs/promises';
          import { createHash } from 'node:crypto';
          import { parseOptions, readProductionWorkerRelease, runCloudStartup, hasStartupInitialization } from './scripts/acceptance/cloud-startup.mjs';
          import { collectProductionTimings,markdown } from './scripts/acceptance/cloud-startup-report.mjs';
          import { readRuntimeTiming,runtimeEvidence } from './scripts/acceptance/cloud-startup-evidence.mjs';
          import { api, activeAlias, PRODUCTION_ALIAS, PROJECT } from './scripts/ops/deployment-regression.mjs';
          // BEGIN DIAGNOSTIC WINDOW PIN
          /** Ops-only control-plane pins. No product request, account call, or polling. */
          function diagnosticWindowPins(env) {
            const value = { botId: env.EXPECTED_DIAGNOSTIC_BOT_ID, id: env.EXPECTED_DIAGNOSTIC_ENV_ID,
              valueSha256: env.EXPECTED_DIAGNOSTIC_VALUE_SHA256, expiresAt: env.EXPECTED_DIAGNOSTIC_EXPIRES_AT }
            if (!/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(value.botId ?? '')
              || !/^[A-Za-z0-9_-]{1,200}$/.test(value.id ?? '') || value.id.startsWith('READY_')
              || !/^[a-f0-9]{64}$/.test(value.valueSha256 ?? '')
              || typeof value.expiresAt !== 'string' || !Number.isFinite(Date.parse(value.expiresAt)))
              throw new Error('acceptance_diagnostic_window_pin_invalid')
            return value
          }
          
          /** Only the verified value's closed identity hashes leave this function. */
          async function readDiagnosticWindowPin(expected, { api, projectId, now = Date.now }) {
            const key = 'MIKKA_CLOUD_DIAGNOSTIC_WINDOW'
            const bad = () => { throw new Error('acceptance_diagnostic_window_changed') }
            const { envs } = await api(`/v10/projects/${projectId}/env`)
            if (!Array.isArray(envs)) bad()
            const rows = envs.filter(row => row.key === key || row.id === expected.id)
            if (rows.length !== 1 || rows[0].id !== expected.id || rows[0].key !== key || rows[0].type !== 'encrypted'
              || rows[0].target?.length !== 1 || rows[0].target[0] !== 'production' || rows[0].gitBranch
              || rows[0].customEnvironmentIds?.length) bad()
            const { value } = await api(`/v1/projects/${projectId}/env/${encodeURIComponent(expected.id)}`)
            const hash = text => createHash('sha256').update(text).digest('hex')
            if (typeof value !== 'string' || hash(value) !== expected.valueSha256) bad()
            let parsed
            try { parsed = JSON.parse(value) } catch { bad() }
            const fields = ['version', 'requesterId', 'workspaceId', 'botId', 'repository', 'expiresAt']
            if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed) || Object.keys(parsed).length !== fields.length
              || Object.keys(parsed).some(name => !fields.includes(name)) || parsed.version !== 1
              || typeof parsed.requesterId !== 'string' || !parsed.requesterId.length || parsed.requesterId.length > 128
              || !/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(parsed.workspaceId ?? '')
              || parsed.botId !== expected.botId || typeof parsed.repository !== 'string'
              || parsed.repository.toLowerCase() !== 'alexj11324/mikka-handoff'
              || parsed.expiresAt !== expected.expiresAt || Date.parse(parsed.expiresAt) <= now()) bad()
            return { status: 'passed', scope: 'dedicated_bot_repository_window', key, ...expected,
              requesterHash: hash(parsed.requesterId).slice(0, 16), workspaceHash: hash('team-workspace\0' + parsed.workspaceId),
              observedAt: new Date(now()).toISOString() }
          }
          // END DIAGNOSTIC WINDOW PIN
          // BEGIN OFFLINE FORMAL REPORT
          /** Offline-only #1505 attachment and independent evidence gate.
           * Embedded verbatim in the unpublished ops workflow; no product or network I/O.
           * This profile is specifically six fresh repository tasks on derived templates.
           */
          const FORMAL_DISPATCH_PHASES = Object.freeze(['authorizeDispatch', 'executionWorkspace', 'requestedAgentProfile',
            'resolveRepository', 'resolveModelDispatch', 'queueCloudRun', 'ensureThreadMachine', 'startLifecycle'])
          const FORMAL_THREAD_PHASES = Object.freeze(['admission', 'execution_identity', 'connect', 'record_sandbox',
            'post_connect_admission', 'runtime_configuration', 'read_worker', 'verify_worker', 'read_refreshed_worker',
            'verify_refreshed_worker', 'start_desktop', 'credential_bootstrap', 'publish_bootstrap', 'start_worker',
            'worker_register', 'verify_runtime', 'finish'])
          const FORMAL_CLAIM_PHASES = Object.freeze(['authorize', 'identity', 'admission', 'acquire_lease',
            'provenance', 'assignment_context', 'credentials_wait', 'response_fence'])
          const FORMAL_SERVER_SPANS = Object.freeze(['cloud.sandbox.credentials', 'cloud.sandbox.create', 'cloud.thread.ensure',
            'cloud.worker.claim', 'cloud.worker.claim.native_credentials', 'cloud.worker.claim.github_credentials'])
          
          const formalMs = value => Number.isFinite(value) && value >= 0
          const formalDate = value => typeof value === 'string' && Number.isFinite(Date.parse(value))
          const formalInterval = value => Number.isSafeInteger(value?.startedAt) && value.startedAt > 0
            && Number.isSafeInteger(value.endedAt) && value.endedAt >= value.startedAt && formalMs(value.ms ?? value.totalMs)
          const formalSeconds = value => formalMs(value) ? (value / 1000).toFixed(3) : 'unavailable'
          const formalUnionMs = phases => {
            let total = 0, end = 0
            for (const phase of [...phases].sort((a, b) => a.startMs - b.startMs)) {
              total += Math.max(0, phase.endMs - Math.max(end, phase.startMs)); end = Math.max(end, phase.endMs)
            }
            return total
          }
          const formalStats = values => {
            const available = values.filter(formalMs).sort((a, b) => a - b), middle = Math.floor(available.length / 2)
            return { valuesMs: values, observed: available.length,
              medianMs: available.length ? available.length % 2 ? available[middle] : (available[middle - 1] + available[middle]) / 2 : null,
              maxMs: available.length ? available.at(-1) : null }
          }
          const formalReleaseMatches = (actual, expected) => Boolean(actual && expected && actual.workerSha === expected.workerSha
            && actual.sourceCommit === expected.sourceCommit && ['desktop', 'claude', 'codex'].every(kind => actual.templates?.[kind] === expected.templates?.[kind]))
          const formalWindowMatches = (actual, expected) => Boolean(actual && expected && actual.status === 'passed'
            && actual.scope === 'dedicated_bot_repository_window' && actual.key === 'MIKKA_CLOUD_DIAGNOSTIC_WINDOW'
            && ['botId', 'id', 'valueSha256', 'expiresAt'].every(key => actual[key] === expected[key])
            && formalDate(actual.observedAt) && formalDate(actual.expiresAt) && Date.parse(actual.observedAt) < Date.parse(actual.expiresAt))
          const formalPinMatches = (pin, sequence, expectedDeploymentId, expectedRelease, expectedDiagnosticWindow) => pin?.status === 'passed'
            && pin.sequence === sequence && pin.expectedDeploymentId === expectedDeploymentId && pin.deploymentId === expectedDeploymentId
            && formalDate(pin.startedAt) && formalDate(pin.finishedAt) && Date.parse(pin.finishedAt) >= Date.parse(pin.startedAt)
            && formalReleaseMatches(pin.workerRelease, expectedRelease)
            && formalWindowMatches(pin.diagnosticWindow, expectedDiagnosticWindow)
          
          function formalActualAcceptance(sample) {
            const timing = sample.timing, runtime = sample.runtimeTiming
            const expectedKind = sample.harness === 'claude_code' ? 'claude_user_ack' : 'codex_turn_start_ack'
            if (timing?.status !== 'aligned' || timing.dispatchBoundary !== 'dispatch_run_entry'
              || runtime?.harness !== sample.harness || runtime.agentAccepted?.kind !== expectedKind
              || !formalMs(runtime.executionStartMs) || !formalMs(runtime.agentAccepted.ms)
              || !formalDate(timing.dispatchStartedAt) || !formalDate(sample.agentStart?.storedAt)) return null
            const stageMs = Date.parse(sample.agentStart.storedAt) - Date.parse(timing.dispatchStartedAt)
            const ackAfterStageMs = Math.max(0, runtime.agentAccepted.ms - runtime.executionStartMs)
            const elapsedMs = stageMs + ackAfterStageMs
            if (!formalMs(stageMs) || !formalMs(timing.dispatchToExecutionStartMs)
              || Math.abs(elapsedMs - timing.dispatchToExecutionStartMs) > 0.01) return null
            return { kind: expectedKind, elapsedMs, stageMs, ackAfterStageMs,
              source: 'stage_database_receipt_plus_same_daemon_monotonic_later_ack_upper_bound' }
          }
          
          function formalStageCoverage(sample, logs, verifyStartupInitialization) {
            const own = logs.filter(log => log.msg === 'cloud_startup_timing' && log.runIdHash === sample.runIdHash)
            const dispatch = logs.filter(log => log.msg === 'dispatch_timing' && log.workflowRunId === sample.workflowRunId
              && log.boundary === 'dispatch_run_entry' && log.failed === false && formalInterval(log)
              && log.startedAt === Date.parse(sample.timing?.dispatchStartedAt) && log.endedAt === Date.parse(sample.timing?.dispatchEndedAt))
            const values = {}, missing = []
            const add = (name, records, valid) => {
              const accepted = records.filter(valid)
              values[name] = accepted.length ? accepted.reduce((sum, item) => sum + item.ms, 0) : null
              if (!accepted.length || accepted.length !== records.length) missing.push(name)
            }
            if (dispatch.length !== 1) missing.push('dispatch.start_finish')
            for (const phase of FORMAL_DISPATCH_PHASES)
              add(`dispatch.${phase}`, dispatch.flatMap(log => log.phases ?? []).filter(item => item.phase === phase), item => formalMs(item.ms))
            for (const stage of FORMAL_SERVER_SPANS) add(stage, own.filter(log => log.stage === stage), formalInterval)
            for (const [stage, phases, prefix] of [['cloud.thread.phases', FORMAL_THREAD_PHASES, 'cloud.thread'],
              ['cloud.worker.claim.phases', FORMAL_CLAIM_PHASES, 'cloud.worker.claim']]) {
              const records = own.filter(log => log.stage === stage).flatMap(log => log.phases ?? [])
              for (const phase of phases) add(`${prefix}.${phase}`, records.filter(item => item.phase === phase), formalInterval)
            }
            for (const stage of ['repository', 'worktree', 'agent_start'])
              add(`daemon.stage.${stage}`, (sample.stages ?? []).filter(item => item.stage === stage), item => item.ok === true && formalMs(item.ms))
            const daemon = sample.daemonStartupTiming
            if (sample.startupTimingStatus !== 'complete' || daemon?.outcome !== 'ok' || daemon.truncated
              || daemon.runIdHash !== sample.runIdHash || daemon.harness !== sample.harness || !formalInterval(daemon)) missing.push('daemon.adapter.start.start_finish')
            values['daemon.adapter.start'] = formalMs(daemon?.ms) ? daemon.ms : null
            const cli = (daemon?.phases ?? []).filter(phase => phase.name === 'daemon.adapter.cli_init' && phase.outcome === 'ok'
              && formalMs(phase.startMs) && formalMs(phase.endMs) && phase.endMs >= phase.startMs && formalMs(phase.ms))
            values['daemon.adapter.cli_init'] = cli.length ? formalUnionMs(cli) : null
            // Use the exact checkout's reader for both paths. A supplied invalid, failed

                claimAuthentication: prepared.claimAuthentication ?? null, observedAuthSource: prepared.observedAuthSource ?? null,
                endedAt: prepared.endedAt, ms: prepared.ms, durationRule: 'independent_origin_overlaps_checkout_and_late_adapter_do_not_sum' } : null,
              dispatchStartFinishRecords: dispatch.length,
              installation: { expectedBranch: 'derived_template_no_bootstrap_call', observedBootstrapRecords: bootstrap.length,
                measuredMs: bootstrap.length ? bootstrap.reduce((sum, log) => sum + log.ms, 0) : null,
                basis: 'published_template_catalog_and_exact_release_pin_plus_source_branch; absence_of_logs_alone_is_not_proof',
                perVmTemplateIdReceipt: 'unavailable' } }
          }
          
          function finalizeAcceptanceReport(report, { expectedBuild, expectedDeploymentId, expectedRelease, expectedDiagnosticWindow, verifyRuntimeEvidence, verifyStartupInitialization }) {
            const reasons = [], samples = report.samples ?? [], logs = report.serverTimingLogs ?? [], pins = report.versionPins ?? []
            const collection = report.serverLogCollection
            if (report.status !== 'passed') reasons.push('driver_not_passed')
            if (report.mode !== 'acceptance' || report.target !== 'cloud' || report.requestedStrategy !== 'derived') reasons.push('branch_profile_unavailable')
            if (samples.length !== 6 || ['claude_code', 'codex'].some(harness => samples.filter(sample => sample.harness === harness).length !== 3)) reasons.push('sample_count_or_harness_distribution')
            if (report.build !== expectedBuild || report.revision !== expectedBuild || !formalReleaseMatches(report.workerRelease?.configuration, expectedRelease)) reasons.push('production_tuple_unconfirmed')
            const pinsComplete = report.versionPinCoverage?.status === 'complete' && pins.length === 14
              && pins.every((pin, index) => formalPinMatches(pin, index + 1, expectedDeploymentId, expectedRelease, expectedDiagnosticWindow))
            if (!pinsComplete) reasons.push('version_pin_coverage_incomplete')
            const logsComplete = collection?.status === 'query_complete' && collection.deploymentId === expectedDeploymentId
              && collection.invalid === 0 && collection.truncated === 0 && collection.records === logs.length
              && formalDate(collection.windowStart) && formalDate(collection.windowEnd) && Date.parse(collection.windowEnd) >= Date.parse(collection.windowStart)
            if (!logsComplete) reasons.push('server_logs_incomplete')
            if (!Array.isArray(report.cleanup?.errors) || report.cleanup.errors.length) reasons.push('global_cleanup_incomplete')
            if (report.officialTiming?.enabled !== true || report.officialTiming.cleaned !== true) reasons.push('official_timing_incomplete')
            const teamConfirmed = report.team?.teamWorkspaceConfirmed === true && report.team.teamAdminMembershipVerified === true
              && report.team.teamSelectionBasis === 'unique-active-admin-identity-match'
              && /^[a-f0-9]{64}$/.test(report.team.teamWorkspaceHash ?? '') && /^[a-f0-9]{16}$/.test(report.accountHash ?? '')
            if (!teamConfirmed) reasons.push('shared_team_identity_unconfirmed')
            const diagnosticWindowConfirmed = pinsComplete && report.officialTiming?.source === 'trusted_claim'
              && report.officialTiming.scope === 'dedicated_bot_repository_window' && report.officialTiming.botId === expectedDiagnosticWindow?.botId
              && pins.every(pin => pin.diagnosticWindow.requesterHash === report.accountHash
                && pin.diagnosticWindow.workspaceHash === report.team?.teamWorkspaceHash)
            if (!diagnosticWindowConfirmed) reasons.push('diagnostic_window_unconfirmed')
            const cases = samples.map((sample, index) => {
              const failures = [], acceptance = formalActualAcceptance(sample), stages = formalStageCoverage(sample, logs, verifyStartupInitialization)
              if (sample.status !== 'execution_proved_awaiting_server_timing') failures.push('execution_proof_incomplete')
              if (!acceptance) failures.push('strict_entry_or_actual_ack_unavailable')
              else if (acceptance.elapsedMs > report.maxStartupMs || report.maxStartupMs !== 5000) failures.push('startup_threshold_exceeded')
              if (sample.execution?.credentialType !== 'subscription' || sample.execution?.identity?.model !== 'subscription'
                || sample.execution?.identity?.runtime !== 'e2b') failures.push('subscription_provenance_incomplete')
              const shared = sample.execution?.sharedScope, identity = sample.execution?.identity
              const sharedConfirmed = teamConfirmed && shared?.verified === true && shared.access === 'workspace_share'
                && shared.requesterHash === report.accountHash && shared.payerHash !== shared.requesterHash
                && /^[a-f0-9]{16}$/.test(shared.payerHash ?? '') && shared.workspaceHash === report.team.teamWorkspaceHash
                && ['connectionHash', 'bindingHash'].every(key => /^[a-f0-9]{16}$/.test(shared[key] ?? ''))
                && /^(0|[1-9][0-9]*)$/.test(shared.connectionRevision ?? '')
                && Number.isInteger(shared.profileVersion) && shared.profileVersion > 0 && /^[a-f0-9]{64}$/.test(shared.profileDigest ?? '')
                && identity?.requesterHash === shared.requesterHash && identity?.executionPrincipalHash === shared.requesterHash
                && identity?.subscriptionAccess?.length === 1 && identity.subscriptionAccess[0] === 'workspace_share'
              if (!sharedConfirmed) failures.push('shared_subscription_identity_unconfirmed')
              if (!pinsComplete || !formalPinMatches(sample.versionPins?.before, 2 + index * 2, expectedDeploymentId, expectedRelease, expectedDiagnosticWindow)
                || !formalPinMatches(sample.versionPins?.after, 3 + index * 2, expectedDeploymentId, expectedRelease, expectedDiagnosticWindow)) failures.push('sample_pins_incomplete')
              if (!(sample.minToolCalls >= 1) || sample.requireReplyAfterTool !== true || sample.replyVerifiedAfterTool !== true
                || !(sample.toolCalls ?? []).some(tool => tool.outcome === 'ok' && /^[a-f0-9]{16}$/.test(tool.toolCallHash ?? ''))) failures.push('post_tool_reply_unproved')
              const runtime = sample.runtimeTiming, official = runtime?.officialCliTiming
              // Reparse the raw, run-bound receipt using this exact checkout's validator;

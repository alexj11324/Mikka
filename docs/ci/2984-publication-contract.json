      "item": "Legacy subscriptions/publish job and report contract",
      "decision": "retain",
      "reason": "Historical legacy sources do not gain modern eligibility without the modern job shape."
    },
    {
      "item": "Product subscription, native tool, source, terminal and cleanup proof",
      "decision": "retain unchanged",
      "reason": "These are independent product guarantees and remain in the original drivers."
    },
    {
      "item": "Artifact transport and ZIP implementation",
      "decision": "reuse one existing reader",
      "reason": "Move the existing bounded reader into runtime-report, re-export from its old Task module, and reuse listing/detail orchestration without a mutual consumer import."
    },
    {
      "item": "Automatic actual report source equals exact main",
      "decision": "retain",
      "reason": "A successful old publication does not authorize a current automatic consumer."
    },
    {
      "item": "Manual workflow/application/worker source separation",
      "decision": "repair using existing ancestry helper",
      "reason": "The actual historical report source differs from its workflow head under the accepted #2699 contract."
    }
  ],

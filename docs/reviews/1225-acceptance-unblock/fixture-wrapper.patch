+'use client'
+
+// Temporary visual data boundary, not a product route or acceptance driver.
+// The imported business components, primitives, translations and submit hook
+// remain byte-for-byte those of the recorded product revision.
+import { useEffect, useMemo, useRef, useState, type MutableRefObject } from 'react'
+import { useLocale } from 'next-intl'
+import { useTheme } from 'next-themes'
+import { SWRConfig, useSWRConfig, type Middleware } from 'swr'
+import { NewTaskDialog } from '@/components/coordinator/new-task-dialog'
+import type { AgentProfilesView } from '@/components/settings/factory-profiles-data'
+import { Button } from '@/components/ui/button'
+import { withBasePath } from '@/lib/base-path'
+
+type Scenario = 'checking' | 'noModels'
+type Theme = 'light' | 'dark'
+type Props = { canvas: boolean; initialScenario: Scenario; initialTheme: Theme }
+
+const WORKSPACE = '12250000-0000-4000-8000-000000000101'
+const DEVICE = '12250000-0000-4000-8000-000000000102'
+const CUSTOM = '12250000-0000-4000-8000-000000000103'
+const CREATED = '2026-11-05T00:00:00.000Z'
+const PREVIEW_PATH = '/preview/1225-default-checking'
+
+function profiles(scenario: Scenario): AgentProfilesView {
+  return {
+    profiles: [{
+      id: CUSTOM, name: 'Synthetic review profile', description: 'Visual fixture only', roles: ['Review'],
+      enabled: true, harness: 'claude_code', model: { mode: 'inherit' }, instructions: '', skills: [],
+      version: 1, digest: 'a'.repeat(64), createdAt: CREATED, updatedAt: CREATED, archivedAt: null,
+    }],
+    catalog: { models: [], skills: [] },
+    availability: { [CUSTOM]: { available: false, reason: 'checking' } },
+    // This stays false. Only the product's intent-selection helper permits
+    // Default/checking; custom checking and noModels retain their real guards.
+    defaultAvailability: { available: false, reason: scenario },
+  }
+}
+
+function sameKey(key: unknown, expected: readonly unknown[]) {
+  return Array.isArray(key) && key.length === expected.length && expected.every((value, index) => key[index] === value)
+}
+
+function readFixture(key: unknown, scenario: Scenario): unknown {
+  if (key === 'issue-creation-available') return true
+  if (key === 'bots') return []
+  if (key === 'devices') return [{
+    id: DEVICE, name: 'Synthetic local computer', deviceType: 'desktop', hostname: 'visual-fixture',
+    platform: 'linux', arch: 'x64', harnesses: [], lastSeenAt: CREATED, enabled: true, online: true, repos: [],
+  }]
+  if (sameKey(key, ['settings:e2b-key', 'current'])) return { configured: false, canEdit: false }
+  if (sameKey(key, ['settings:model-order', 'current'])) return {
+    location: 'local', first: { kind: 'device', id: DEVICE }, entries: [], readyDeviceIds: [DEVICE],
+    preferredHarness: 'claude_code', autoModelRouting: false,
+  }
+  if (sameKey(key, ['factory-agent-profiles', WORKSPACE]) ||
+      sameKey(key, ['factory-agent-profiles', WORKSPACE, 'local', DEVICE])) return profiles(scenario)
+  // Never invoke a component's real fetcher as a fallback. This fixture has
+  // neither an authenticated user nor an authorized application data source.
+  throw new Error('VISUAL_FIXTURE_READ_NOT_ALLOWLISTED')
+}
+
+function readBoundary(currentScenario: () => Scenario): Middleware {
+  return useSWRNext => (key, _fetcher, config) => {
+    // The closed fixture supplies this key's data shape; retain the caller's
+    // generic fetcher contract without invoking its real data source.
+    const fixtureFetcher = (async () => readFixture(key, currentScenario())) as typeof _fetcher
+    return useSWRNext(key, fixtureFetcher, {
+      ...config, revalidateOnFocus: false, revalidateOnReconnect: false,
+      refreshInterval: 0, shouldRetryOnError: false,
+    })
+  }
+}
+
+function Canvas({ scenario, theme }: { scenario: Scenario; theme: Theme }) {
+  const current = useRef(scenario)
+  const config = useMemo(() => ({ provider: () => new Map(), use: [readBoundary(() => current.current)] }), [])
+  return <SWRConfig value={config}><CanvasBody current={current} theme={theme} /></SWRConfig>
+}
+
+function CanvasBody({ current, theme }: { current: MutableRefObject<Scenario>; theme: Theme }) {
+  const [open, setOpen] = useState(true)
+  const [scenario, setScenario] = useState(current.current)
+  const { setTheme } = useTheme()
+  const { mutate } = useSWRConfig()
+  useEffect(() => { setTheme(theme) }, [setTheme, theme])
+  async function changeAvailability(next: Scenario) {
+    current.current = next
+    setScenario(next)
+    await Promise.all([
+      mutate(['factory-agent-profiles', WORKSPACE], profiles(next), { revalidate: false }),
+      mutate(['factory-agent-profiles', WORKSPACE, 'local', DEVICE], profiles(next), { revalidate: false }),
+    ])
+    setOpen(true)
+  }
+  return <main className="min-h-screen bg-background p-4 text-foreground" data-visual-fixture="1225-default-checking" data-scenario={scenario}>
+    <p className="mb-3 text-xs text-muted-foreground">Synthetic component review · no account · do not submit</p>
+    <div className="flex flex-wrap gap-2" aria-label="In-frame fixture controls">
+      <Button type="button" variant="outline" onClick={() => setOpen(true)}>Open New task</Button>
+      <Button type="button" variant="outline" onClick={() => { void changeAvailability('checking') }}>Set checking and reopen</Button>
+      <Button type="button" variant="outline" onClick={() => { void changeAvailability('noModels') }}>Set unavailable and reopen</Button>
+    </div>
+    <NewTaskDialog open={open} onOpenChange={setOpen} workspaceId={WORKSPACE}
+      initialText="Visual review fixture only. Do not submit this text." />
+  </main>
+}
+
+export function DefaultCheckingVisualFixture({ canvas, initialScenario, initialTheme }: Props) {
+  const locale = useLocale()
+  const { setTheme } = useTheme()
+  const [scenario, setScenario] = useState<Scenario>(initialScenario)
+  const [theme, selectTheme] = useState<Theme>(initialTheme)
+  const [narrow, setNarrow] = useState(false)
+  useEffect(() => { setTheme(theme) }, [setTheme, theme])
+  if (canvas) return <Canvas scenario={initialScenario} theme={initialTheme} />
+  const viewport = narrow ? { width: 390, height: 844 } : { width: 1024, height: 768 }
+  const query = new URLSearchParams({ canvas: '1', scenario, theme })
+  const src = withBasePath(`/${locale}${PREVIEW_PATH}?${query.toString()}`)
+  return <main className="min-h-screen bg-background p-4 text-foreground" data-visual-review="1225">
+    <h1 className="text-lg font-medium">Issue 1225 · component visual review</h1>
+    <p className="mt-1 text-sm text-muted-foreground">Synthetic read data only. No account, task, model call or production acceptance. Do not click Create task.</p>
+    <div className="my-4 flex flex-wrap gap-2" aria-label="Visual fixture controls">
+      <Button type="button" variant={scenario === 'checking' ? 'default' : 'outline'} onClick={() => setScenario('checking')}>Default checking</Button>
+      <Button type="button" variant={scenario === 'noModels' ? 'default' : 'outline'} onClick={() => setScenario('noModels')}>Confirmed unavailable control</Button>
+      <Button type="button" variant={theme === 'light' ? 'default' : 'outline'} onClick={() => selectTheme('light')}>Light</Button>
+      <Button type="button" variant={theme === 'dark' ? 'default' : 'outline'} onClick={() => selectTheme('dark')}>Dark</Button>
+      <Button type="button" variant={!narrow ? 'default' : 'outline'} onClick={() => setNarrow(false)}>1024 px desktop</Button>
+      <Button type="button" variant={narrow ? 'default' : 'outline'} onClick={() => setNarrow(true)}>390 px mobile</Button>
+    </div>
+    <p className="mb-2 text-xs text-muted-foreground">Actual iframe viewport: {viewport.width} × {viewport.height}; initial scenario: false/{scenario}. In-frame controls can change that scenario while retaining the selection. Custom checking remains disabled.</p>
+    <div className="overflow-auto rounded-lg border bg-muted/20 p-2">
+      <iframe key={`${scenario}:${theme}:${narrow}`} src={src}
+        title={`Default ${scenario}, ${theme}, ${viewport.width} px visual fixture`}
+        width={viewport.width} height={viewport.height}
+        className="block max-w-none border-0 bg-background" />
+    </div>
+  </main>
+}

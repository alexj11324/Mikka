+import type { Metadata } from 'next'
+import { notFound } from 'next/navigation'
+import { DefaultCheckingVisualFixture } from './harness'
+
+// Temporary build-only fixture for issue #1225. Do not commit this route.
+// It creates no account, session, database fixture, task, or API permission.
+export const dynamic = 'force-dynamic'
+export const metadata: Metadata = {
+  title: 'Issue 1225 component review',
+  robots: { index: false, follow: false },
+}
+
+type Search = Record<string, string | string[] | undefined>
+
+export default async function DefaultCheckingPreview({ searchParams }: { searchParams: Promise<Search> }) {
+  if (process.env.NODE_ENV !== 'production' || process.env.MIKKA_1225_VISUAL_REVIEW !== '1') notFound()
+  const search = await searchParams
+  const allowed = new Set(['canvas', 'scenario', 'theme', '_rsc'])
+  if (Object.keys(search).some(key => !allowed.has(key) || Array.isArray(search[key]))) notFound()
+  if (search.canvas !== undefined && search.canvas !== '1') notFound()
+  if (search.scenario !== undefined && search.scenario !== 'checking' && search.scenario !== 'noModels') notFound()
+  if (search.theme !== undefined && search.theme !== 'light' && search.theme !== 'dark') notFound()
+  return <DefaultCheckingVisualFixture canvas={search.canvas === '1'}
+    initialScenario={search.scenario === 'noModels' ? 'noModels' : 'checking'}
+    initialTheme={search.theme === 'dark' ? 'dark' : 'light'} />
+}

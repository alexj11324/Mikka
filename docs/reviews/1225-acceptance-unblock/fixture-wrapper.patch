+// Temporary, read-only publication boundary for the #1225 component fixture.
+// It is not an application route, authentication adapter, or deployment proxy.
+import http from 'node:http'
+import { normalize } from 'node:path/posix'
+
+function port(name, fallback) {
+  const value = process.env[name] ?? String(fallback)
+  if (!/^[0-9]{1,5}$/.test(value) || Number(value) < 1024 || Number(value) > 65535) throw new Error('VISUAL_GATEWAY_INVALID_PORT')
+  return Number(value)
+}
+
+if (process.env.MIKKA_1225_VISUAL_REVIEW !== '1') throw new Error('VISUAL_GATEWAY_OPT_IN_REQUIRED')
+const upstreamPort = port('MIKKA_VISUAL_UPSTREAM_PORT', 3110)
+const listenPort = port('MIKKA_VISUAL_GATEWAY_PORT', 3111)
+if (upstreamPort === listenPort) throw new Error('VISUAL_GATEWAY_PORT_COLLISION')
+
+const pages = new Set([
+  '/mikka/en/preview/1225-default-checking',
+  '/mikka/zh-CN/preview/1225-default-checking',
+])
+const assetSuffix = /\.(?:js|css|woff2?|ttf|otf|png|jpe?g|webp|avif|svg|ico)$/
+const security = {
+  'cache-control': 'no-store, max-age=0',
+  'x-content-type-options': 'nosniff',
+  'referrer-policy': 'no-referrer',
+  'x-robots-tag': 'noindex, nofollow, noarchive',
+  'x-frame-options': 'SAMEORIGIN',
+  'content-security-policy': "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'none'; form-action 'none'",
+}
+
+function target(raw) {
+  if (typeof raw !== 'string' || raw.length > 4096 || !raw.startsWith('/') || raw.startsWith('//') || /[\\#\u0000-\u0020\u007f]/.test(raw)) return null
+  const index = raw.indexOf('?')
+  const rawPath = index < 0 ? raw : raw.slice(0, index)
+  const query = index < 0 ? '' : raw.slice(index + 1)
+  let path
+  try { path = decodeURIComponent(rawPath) } catch { return null }
+  // Check decoded segments before URL/path normalization. In particular,
+  // encoded traversal, separators, double encoding and backslashes fail closed.
+  if (!path.startsWith('/') || path.startsWith('//') || /[%\\?#\u0000-\u0020\u007f]/.test(path)) return null
+  const segments = path.slice(1).split('/')
+  if (segments.some(segment => segment === '' || segment === '.' || segment === '..')) return null
+  if (normalize(path) !== path) return null
+  if (/%(?:2f|5c)/i.test(rawPath)) return null
+  if (query.length > 512 || /%(?![0-9a-f]{2})/i.test(query)) return null
+  const params = new URLSearchParams(query)
+  const seen = new Set()
+  for (const [key, value] of params) {
+    if (seen.has(key) || /[%\\#\u0000-\u0020\u007f]/.test(key + value)) return null
+    seen.add(key)
+    if (pages.has(path)) {
+      if (!((key === 'canvas' && value === '1') || (key === 'scenario' && ['checking', 'noModels'].includes(value)) ||
+          (key === 'theme' && ['light', 'dark'].includes(value)) || (key === '_rsc' && /^[a-zA-Z0-9_-]{1,100}$/.test(value)))) return null
+    } else if (!(['v', 'dpl'].includes(key) && /^[a-zA-Z0-9._-]{1,100}$/.test(value))) return null
+  }
+  const page = pages.has(path)
+  const asset = path.startsWith('/mikka/_next/static/') && assetSuffix.test(path)
+  const version = path === '/mikka/api/version' && query === ''
+  const icon = path === '/mikka/favicon.ico' && query === ''
+  if (!page && !asset && !version && !icon) return null
+  return rawPath + (query ? `?${query}` : '')
+}
+
+function reject(response, status, code) {
+  response.writeHead(status, { ...security, 'content-type': 'text/plain; charset=utf-8' })
+  response.end(code)
+}
+
+const requestHeaders = ['accept', 'accept-encoding', 'accept-language', 'user-agent', 'cache-control', 'range', 'if-none-match', 'if-modified-since', 'host', 'origin']
+const responseHeaders = ['content-type', 'content-length', 'content-encoding', 'etag', 'last-modified', 'vary', 'accept-ranges', 'content-range']
+const server = http.createServer((request, response) => {
+  if (request.method !== 'GET' && request.method !== 'HEAD') { reject(response, 405, 'VISUAL_GATEWAY_READ_ONLY'); request.resume(); return }
+  if (request.headers['transfer-encoding'] !== undefined || (request.headers['content-length'] !== undefined && request.headers['content-length'] !== '0')) { reject(response, 400, 'VISUAL_GATEWAY_BODY_REFUSED'); request.resume(); return }
+  const path = target(request.url)
+  if (!path) { reject(response, 404, 'VISUAL_GATEWAY_PATH_REFUSED'); return }
+  const host = request.headers.host
+  if (typeof host !== 'string' || host.length > 255 || /[\s/\\?#@,]/.test(host)) { reject(response, 400, 'VISUAL_GATEWAY_HOST_REFUSED'); return }
+  // Preserve actual Host and Origin; do not fabricate an authenticated local
+  // origin. No cookie, bearer, forwarded identity, or Server Action header is
+  // sent upstream. Only this fixed loopback process can receive the request.
+  const headers = Object.fromEntries(requestHeaders.flatMap(name => request.headers[name] === undefined ? [] : [[name, request.headers[name]]]))
+  const upstream = http.request({ hostname: '127.0.0.1', port: upstreamPort, method: request.method, path, headers, timeout: 15_000 }, incoming => {
+    const status = incoming.statusCode ?? 502
+    if (status >= 300 && status < 400 && status !== 304) {
+      incoming.resume(); reject(response, 502, 'VISUAL_GATEWAY_REDIRECT_REFUSED'); return
+    }
+    const selected = Object.fromEntries(responseHeaders.flatMap(name => incoming.headers[name] === undefined ? [] : [[name, incoming.headers[name]]]))
+    // Never issue a browser cookie through this account-free fixture gateway.
+    response.writeHead(status, { ...selected, ...security })
+    incoming.on('error', () => response.destroy())
+    incoming.pipe(response)
+  })
+  upstream.on('timeout', () => upstream.destroy(new Error('VISUAL_GATEWAY_UPSTREAM_TIMEOUT')))
+  upstream.on('error', () => {
+    if (!response.headersSent) reject(response, 502, 'VISUAL_GATEWAY_UPSTREAM_UNAVAILABLE')
+    else response.destroy()
+  })
+  response.on('close', () => { if (!response.writableEnded) upstream.destroy() })
+  upstream.end()
+})
+server.requestTimeout = 20_000
+server.headersTimeout = 10_000
+server.keepAliveTimeout = 5_000
+server.on('upgrade', (_request, socket) => socket.destroy())
+server.on('clientError', (_error, socket) => { socket.end('HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n') })
+server.listen(listenPort, '0.0.0.0', () => {
+  console.log(JSON.stringify({ event: 'visual_gateway_ready', port: listenPort, upstream: 'loopback', methods: ['GET', 'HEAD'], scope: 'synthetic_component_review_only' }))
+})
+for (const signal of ['SIGINT', 'SIGTERM']) process.on(signal, () => {
+  server.close(() => { process.exitCode = 0 })
+  server.closeIdleConnections()
+  setTimeout(() => { server.closeAllConnections(); process.exitCode = 0 }, 1000).unref()
+})

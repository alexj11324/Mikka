+      if (row.loaderId !== undefined) assert.ok(integer(row.loaderId))
+      if (row.cdpMonotonicMs !== undefined) assert.ok(row.cdpMonotonicMs === null || finite(row.cdpMonotonicMs))
+    } else assert.fail('DIAGNOSTIC_ROW_KIND')
+  }
+  return true
+}

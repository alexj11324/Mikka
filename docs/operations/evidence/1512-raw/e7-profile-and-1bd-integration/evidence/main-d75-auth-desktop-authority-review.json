  "findings": [
    {
      "id": "authority-preserves-request",
      "paths": [
        "apps/api/runtime/request-authority.ts",
        "apps/api/request-authority-module.mjs",
        "apps/api/nitro.config.ts"
      ],
      "observation": "New production node-server authority selects only exact configured origins, allows HTTP only on loopback and rejects duplicate/conflicting authority headers. It adjusts the original request URL and forwards the same Request, retaining headers, body, abort and runtime context. The guard adds no database access.",
      "requiredMerge": "Keep main nodeRequestAuthority and builtinServices together with feature workflowDevelopmentAliases, workflowNodeExternals and existing Vercel authority. Preserve feature generated trace/route wrappers.",
      "limitation": "Rejected requests may end before route instrumentation; actual merged HTTP ingress was not executed."
    },
    {
      "id": "origin-guard-and-atomic-exchange",
      "paths": [
        "lib/desktop-auth.ts",
        "app/api/desktop/begin/route.ts",
        "app/api/desktop/exchange/route.ts",
        "lib/desktop-rpc/handler.ts"
      ],
      "observation": "Main desktopSameOriginRequest accepts missing native browser headers, but rejects mismatched Origin and Sec-Fetch-Site except absent, same-origin or none. It runs before body/auth work and is header-only.",
      "requiredMerge": "Add main guards without reverting feature single-statement locked exchange consumption, first-attempt token clearing, expiry/revocation checks or BetterAuth OTT verification. Keep noteLogRpcAction after registered-action validation, per-item authorization and batch behavior.",
      "limitation": "No new PostgreSQL concurrency or token-burn execution in this review."
    },
    {
      "id": "session-proof-unchanged",
      "paths": [
        "lib/desktop-rpc/authentication.ts",
        "lib/desktop-rpc/session.ts",
        "lib/desktop-rpc/session-cache.ts",
        "lib/fresh-session.ts"
      ],
      "observation": "All four files are byte-identical in base, main and feature. Token-bound signed cache, native bearer isolation from browser cookies, request-local reuse and fresh expiry/revocation reads remain unchanged.",
      "requiredMerge": "Retain feature identity-only Web PKCE and full-workspace phase/session fences. Main does not replace that renderer machinery.",
      "limitation": "Required fresh-session and rate-limit operations are neither removed nor assumed free."
    },
    {
      "id": "edition-and-defaults-change-baseline",
      "paths": [
        "lib/edition.ts",
        ".github/workflows/desktop.yml",
        ".github/workflows/ui-policy.yml",
        ".github/workflows/web-deploy.yml",
        "lib/posthog-server.ts",
        "lib/feature-flags.ts",
        "lib/builtin-gateway/config.ts"
      ],
      "observation": "Default edition becomes community; main hosted workflows explicitly select cloud. Builtin gateway/scheduler stay disabled for cloud/VERCEL, while explicit external worker settings retain precedence. Separately, absence of a PostHog client now uses productionFlagDefault rather than all flags false; this server default is not community-only.",
      "requiredMerge": "Keep explicit cloud selection and configured feature/model/gateway metadata. Merge main defaults into feature bounded PostHog queue, safe errors, timestamps and flush hooks.",
      "limitation": "Cloud edition by itself does not prove old e7 feature states or SQL costs unchanged."
    },
    {
      "id": "discovery-cost-boundary",
      "paths": [
        "lib/desktop-discovery.ts",
        "app/api/desktop/discovery/route.ts",
        "apps/desktop/src/main/server-discovery.ts",
        "apps/desktop/src/main/bundled-servers.ts",
        "lib/auth-config.ts"
      ],
      "observation": "Ordinary discovery projects public configuration. GITHUB_SIGN_IN_USE_APP enables auth initialization/credential resolution, so that opt-in path is not established as zero database work. Existing Desktop discovery client is byte-identical and runs from explicit probe rather than state/select.",
      "requiredMerge": "Preserve exact-origin, no-credential, no-redirect discovery validation and main configuration negotiation.",
      "limitation": "A new endpoint is not proof of an extra automatic login/startup request; no discovery call was executed."
    },
    {
      "id": "coordinator-query-cost-changes",
      "paths": [
        "lib/coordinator/store.ts",
        "lib/coordinator/wake.ts",
        "lib/coordinator/model-ready.ts",
        "lib/default-model-config.ts",
        "app/actions/coordinator.ts"
      ],
      "observation": "chatViewState and chatVersionState each replace three separate default-path reads with one bounded coherent SQL statement. coordinatorEnabled can now perform selected-model readiness authorization through database readers when no server default or mock fixture is available. A configured default avoids that readiness branch.",
      "requiredMerge": "Keep coherent snapshot and readiness authorization semantics while retaining feature tracing.",
      "limitation": "Static statement comparison, not measured whole-window savings; changes can affect costs in either direction. Large unrelated backfill/migration semantics are outside this review."
    },
    {
      "id": "task-runs-and-live-preservation",
      "paths": [
        "app/actions/task-runs.ts",
        "lib/builtin-gateway/config.ts"
      ],
      "observation": "Main replaces the explicit worker presence guard with gatewayConfig, adding community/builtin mode without changing feature renderer batching or Live trigger code.",
      "requiredMerge": "Preserve feature latest-200 issue selection, owner-filtered bot joins, three-level runBotId fallback, fingerprint/expiry aggregate, revision-before-data ordering and separate database pools.",
      "limitation": "Main is not shown to resolve old e7 extra reads or otherScoped SQL."
    },
    {
      "id": "trace-ai-and-new-step",
      "paths": [
        "lib/coordinator/decide.ts",
        "lib/posthog-server.ts",
        "lib/posthog-config.ts",
        "lib/tracing/context.ts",
        "lib/tracing/ai.ts",
        "workflows/coordinator/finish-turn.ts",
        "packages/daemon/src/server-link-http.ts"
      ],
      "observation": "Main adds a normal use-step bounded-turn handoff and configurable decision credentials/cloud billing checks. Protected API request cache and base protocol/tracing files are unchanged. Daemon HTTP diff changes only a comment URL. Existing SDK continuous propagation applies to the added step when retained.",
      "requiredMerge": "Keep main credential/edition semantics plus feature per-generation spans, numeric receipts, failure accounting, safe stage logs and flush behavior. Do not restore old content-bearing/unbounded analytics.",
      "limitation": "Custom PostHog host configuration does not broaden daemon endpoint validation: official US/EU plus development loopback remain allowed. Arbitrary self-hosted cross-service telemetry is not attested."
    },
    {
      "id": "build-and-test-provenance",
      "paths": [
        "apps/api/nitro.config.ts",
        "apps/api/scripts/build.mjs",
        "package.json"
      ],
      "observation": "MIKKA_BUILD_REVISION now precedes deployment/git fallback. A configured string does not replace actual checkout/tree/manifest/artifact proof. Main test:desktop-auth adds discovery; feature adds batch/context/exchange cases.",
      "requiredMerge": "Keep both sides of test scripts and exact-source/artifact evidence guards.",
      "limitation": "No integrated main checkout, new CI result or runtime source identity is claimed."
    }
  ],

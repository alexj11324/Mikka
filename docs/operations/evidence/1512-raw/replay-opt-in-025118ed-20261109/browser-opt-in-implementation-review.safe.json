    "sdkVersion": "posthog-js@1.438.13",
    "sdkCommit": "f831af3d33eab4d8cea8c3e4d360d76038912ee4",
    "chain": [
      "Mikka actor uses headless Chromium with no UA or automation-signal overrides",
      "SDK default opt_out_useragent_filter=false",
      "isLikelyBot matches blocked UA/brands or navigator.webdriver",
      "capture returns before before_send for detected bots",
      "Replay recorder sends through capture('$snapshot')",
      "Mikka bridge observes only sanitized snapshots in before_send",
      "Therefore default actor cannot satisfy its pre-submit snapshot readiness gate"
    ],
    "scope": "Source-derived blocker for the current standard actor. No historical session query or claim that every prior zero-session result has this cause."
  },
  "publicInstance": {
    "moduleEntry": "init_as_module returns the module singleton without assigning window.posthog",
    "globalAssignment": "Only init_from_snippet assigns window.posthog",
    "appSearches": {
      "windowPosthogMatches": 0,
      "globalThisPosthogMatches": 0
    },
    "decision": "No hidden bundle access or SDK-object exposure; configure existing import at initialization with a bounded explicit document marker."
  },
  "candidateContract": {
    "marker": "__mikkaAcceptanceReplayUntil",
    "reader": "Own data descriptor only; safe integer strictly future and at most 600000ms ahead; inherited/getter/expired/invalid values fail closed",
    "injection": "One context.addInitScript before newPage; exact app origin, /mikka path boundary, top document, unexpired deadline",
    "expiry": "Initialization qualification only. No automatic reversion of an already initialized SDK; owned context closure ends the instance.",
    "sdkOption": "opt_out_useragent_filter",
    "ordinaryVisitors": "False when no valid explicit own marker; no project-wide configuration change",
    "classification": "Preserve only SDK-produced exact bot/browser strings on allowed ordinary and snapshot events; no raw UA or additional property capture"
  },
  "conservation": {
    "observerBodyUnchanged": true,

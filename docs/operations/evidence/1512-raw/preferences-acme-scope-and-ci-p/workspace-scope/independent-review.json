  "findings": [
    {
      "id": "actual_detail_scope",
      "result": "pass",
      "basis": "The authenticated detail adapter reads the owner-scoped task body and then factoryLiveScopes(..., taskId, session.user.id). Task scope uses the persisted Bot workspace and active owner membership; the list's live scope belongs to the visible issue and is not used to exclude tasks."
    },
    {
      "id": "closed_task_binding",
      "result": "pass",
      "basis": "Only unsettled list rows with valid task ID, exact issue ID, safe nonnegative revision, closed stage/status and nullable valid attempt/candidate IDs are read. Detail must have the authenticated owner and exactly match id, issueId, revision, stage, status, attemptId and candidateId."
    },
    {
      "id": "explicit_other_workspace",
      "result": "pass",
      "basis": "Only a valid UUID liveWorkspaceId different from the current workspace permits exclusion. Same, null, absent, malformed or mismatched proof remains blocked. HTTP/read failures are not converted into permission to proceed."
    },
    {
      "id": "limited_read",
      "result": "pass",
      "basis": "Each unsettled historical list row receives one existing authenticated GET per quiet call. Already settled rows skip detail GET. Existing batching remains at ten issues concurrently, with task details sequential within each issue."
    },
    {
      "id": "unchanged_authority_and_cleanup",
      "result": "pass",
      "basis": "The driver diff is restricted to quiet(). settledTask, ownerIdle, the explicit ACME credentials, workspace/subscription checks and owned task cancellation / machine cleanup are byte-identical to a23."
    },
    {
      "id": "sequential_not_atomic",
      "result": "limitation",
      "basis": "Task body and live workspace are sequential reads, not an atomic database snapshot. The list/detail version equality guards observed row changes but does not claim transaction-wide or future-idle guarantees. The historical issue is not assumed to be personal."
    },
    {
      "id": "direct_tests",
      "result": "pass",
      "basis": "Five new tests cover exact other-workspace exclusion without writes, thirteen rejecting proof variants, failed/blocked same-workspace tasks, six unchanged settled variants, and cancelling only this acceptance's own failed task while leaving historical tasks untouched."
    }
  ],

+    const report = await run(data)
+    assert.equal(report.status, 'blocked'); assert.equal(report.cases[0].code, 'workspace_busy')
+    assert.equal(data.state.cancelled.size, 0); assert.equal(data.state.closed, 1); safe(report)
+  }
+})

  "design": {
    "A": {
      "purpose": "Share one policy observation only within an explicitly bounded foreground chat model-read operation.",
      "entrypoints": [
        "app/actions/coordinator.ts:readFullChat coordinatorEnabled call",
        "app/actions/coordinator.ts:readCoordinatorChat coordinatorEnabled call"
      ],
      "scope": "Fresh ALS lifetime only for this explicit read; existing active Native batch uses its existing observation.",
      "key": "Actual COMMIT_EXECUTOR object (or database object) plus exact workspaceId.",
      "cleanup": "finally active=false and map.clear on fulfillment/rejection; inherited callbacks after completion read fresh.",
      "deferred": "after:/cron:/workflow: bypass both opening and consuming the foreground observation; ordinary permission calls remain fresh.",
      "unchanged": "Credential query, own/shared key results, pooled owner results, action auth, wake/dispatch/write paths, error propagation and response contracts are unchanged.",
      "limits": "Both FIRST chat calls were already batched; no claim this new standalone scope directly reduces FIRST."
    },
    "B": {
      "purpose": "Co-read the closed prepared list counters at an already authorized selected workspace before its data reads.",
      "closedKinds": [
        "issues.syncIssueList -> issue_list",
        "task-runs.pollTaskRuns -> task_run_list",
        "task-runs.syncThreadList -> thread_list"
      ],
      "admission": "Only an explicit non-null valid workspace with a requested matching prepared list key can start its workspace plan; the product caller has already authorized that workspace.",
      "key": "Revision queue now uses actual COMMIT_EXECUTOR object (or database object); values remain keyed by valid kind+exact workspace UUID.",
      "projection": "Only the caller's original valid requested keys are returned; earlier counters stay conservative for live freshness.",
      "isolation": "No Personal-home substitution; entity/mismatched/null refs cannot start the Team plan; after/cron/workflow reads bypass the foreground plan and queue.",
      "unchanged": "Per-action membership/content checks remain in their original callers; no membership results, rows, sessions, or auth grants are cached here.",
      "limits": "The real PG append tests the helper after caller authorization, not actual membership admission. Its SQL/row metrics exclude wire/TLS bytes."
    }
  },

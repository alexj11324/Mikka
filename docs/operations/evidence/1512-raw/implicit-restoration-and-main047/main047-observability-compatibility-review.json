  "findings": [
    {
      "code": "DB_REGION_METADATA_ONLY",
      "paths": [
        "lib/tracing/sanitize.ts",
        "lib/tracing/tracing.test.ts"
      ],
      "facts": [
        "Caller supplied mikka.db_peer_region is deleted; only actual PostgreSQL host matching the closed Neon us-east-1/us-east-2 grammar produces a regional label.",
        "Endpoint and account-bearing host remain unexported; node exporter sanitizes the original span once. No sampling or generation fields are removed."
      ]
    },
    {
      "code": "BOOTSTRAP_CARRIER_PRESERVED",
      "paths": [
        "lib/cloud-computer/thread-machines.ts",
        "packages/daemon/bin/cloud-worker.ts",
        "packages/daemon/src/cloud-bootstrap.ts"
      ],
      "facts": [
        "bootstrap JSON still contains captureTraceContext({runId}) and daemonTraceSettings before exact-byte SHA256 hints are generated.",
        "Worker configures daemon tracing then enters withContext(config.traceContext) before optional anonymous Claude startup.",
        "Initial run and anonymous hints are separately bounded, owned, nofollow, one-use, and bound to the original bootstrap bytes."
      ]
    },
    {
      "code": "CLAUDE_GENERATION_PATH_PRESERVED",
      "paths": [
        "packages/daemon/src/adapters/claude.ts",
        "packages/daemon/src/anonymous-claude-spare.ts"
      ],
      "facts": [
        "Both ordinary and anonymous SDK configuration retain includePartialMessages:daemonTracer.enabled; immutable adoption compares this value.",
        "The same ClaudeGenerationMetrics callback captures options.traceContext and observes every consumed SDK message; iterator exceptions still call generations.fail().",
        "Cache usage, TTFT and per-generation source implementation are outside this main diff and are not replaced by preparation timing."
      ]
    },
    {
      "code": "DIAGNOSTIC_TIMING_DISTINCT_FROM_AI",
      "paths": [
        "packages/daemon/src/official-cli-timing.ts",
        "packages/daemon/src/tracing.ts",
        "scripts/acceptance/cloud-startup.mjs"
      ],
      "facts": [
        "bootstrap_claude_start keeps the original earlier timestamp and adds closed claimAuthentication/observedAuthSource fields.",
        "Unclaimed candidate close uses publish:false; fresh matching claim can transfer the collector once.",
        "CLOUD_STARTUP_TIMING controls persisted diagnostic collection, not normal OTel or generation instrumentation.",
        "cloud-startup acceptance parses the new timing source and rejects unknown authentication provenance; an anonymous prewarm alone is not a completed model acceptance."
      ]
    },
    {
      "code": "MCP_SHARED_BACKEND_PRESERVES_BUSINESS_PATH",
      "paths": [
        "packages/daemon/src/agents/mikka-mcp.mjs",
        "packages/daemon/src/agents/mikka-mcp-backend.mjs",
        "packages/daemon/src/agents/mikka-mcp-bridge.ts",
        "packages/daemon/src/agents/mikka-mcp-worker.mjs",
        "packages/daemon/src/agents/run-context.ts"
      ],
      "facts": [
        "The existing handlers and closed MCP HTTP observer move to a shared backend used by stdio and the late-bound SDK worker.",
        "Decision URL/token/catalogue/observation URL move through the private bound context; new worker stdout/stderr are ignored, no credentials are printed.",
        "Bridge admission checks current local authority and one-use context binding; backend aborts held HTTP and drains accepted work.",
        "No new W3C headers or automatic tracing SDK import are added to the MCP helper; the old decision transport also did not set those headers. No new regression is established from that absence."
      ]
    },
    {
      "code": "CODEX_AND_EXPORT_DRAIN_PRESERVED",
      "paths": [
        "packages/daemon/src/adapters/codex.ts",
        "packages/daemon/src/subscription-hosted-runner.ts",
        "packages/daemon/src/tracing.ts",
        "packages/daemon/src/main.ts"
      ],
      "facts": [
        "Codex adapter and native generation/collection/sampling modules have no change in this commit diff.",
        "Hosted Codex still receives cliTiming before its final native trace receiver settings; Claude-only timing injection is preserved.",
        "Daemon stop awaits candidate close before outbox and daemonTracer.shutdown; generation drain, flush/shutdown and retaining sampler bodies remain unchanged."
      ]
    },
    {
      "code": "REGISTRATION_NOTICE_IS_NOT_AUTHORITY",
      "paths": [
        "lib/computer/registration-command.ts",
        "lib/cloud-computer/thread-registration.ts",
        "lib/cloud-computer/thread-machines.ts",
        "packages/daemon/src/cloud-registration.ts"
      ],
      "facts": [
        "New release capability binds to the actual worker digest; readiness file includes only device/workspace IDs and credential hash.",
        "Server finish still holds run then machine locks and checks current token, lease and stop marker in a subsequent SQL statement.",
        "Legacy workers retain the old polling fallback only when the declared capability is absent; new path does not replace the fresh claim.",
        "Registration interval can fall in start_worker when transport coalesces stdout; no interval is moved outside parent timing."
      ]
    },
    {
      "code": "NORMAL_E2B_REBUILD_REQUIRED",
      "paths": [
        "scripts/e2b/build-template.py",
        "packages/daemon/scripts/build-cloud-worker.mjs",
        "packages/daemon/scripts/build.mjs",
        "packages/daemon/scripts/official-e2b-instance-bootstrap.sh"
      ],
      "facts": [
        "Worker/recipe hash includes changed daemon and protocol source and build helpers. This main is not a test-script-only no-op hash change.",
        "Both build outputs copy new standalone MCP backend/worker assets; cloud builder emits a capability only with a validated actual worker digest.",
        "Bootstrap passes the worker digest, not a different source-commit identifier. Existing conservation/model receipt and independent subscription release gates remain required.",
        "No actual worker hash or build was executed during this review."
      ]
    },
    {
      "code": "LOG_FORWARDING_AND_REGION_CHANGE_LIMITS",
      "paths": [
        "lib/cloud-computer/thread-machines.ts",
        ".github/workflows/web-deploy.yml"
      ],
      "facts": [
        "Fallback worker stdout forwarding is replaced by detached start and retained tee log/tail capture on registration failure. It does not replace or disable daemon OTLP export.",
        "Web deploy now explicitly requests cle1. Earlier deployment-latency/region observations are not new-source performance proof."
      ]
    }
  ],

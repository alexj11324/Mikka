    "sql_cells": [
      {
        "node_id": "8f15f2e8-8c0b-4505-b0d7-e6150c8d5cb3",
        "cell_type": "sql",
        "dataframe_name": "recent_runtime_traces",
        "code": "SELECT\n    formatDateTime(toTimeZone(min(timestamp), 'UTC'), '%Y-%m-%d %H:%i:%S') AS started_utc,\n    lower(hex(base64Decode(trace_id))) AS trace_id_hex,\n    arrayStringConcat(groupUniqArray(service_name), ', ') AS services,\n    arrayStringConcat(groupUniqArrayIf(attributes['mikka.run_id'], notEmpty(coalesce(attributes['mikka.run_id'], ''))), ', ') AS run_ids,\n    arrayStringConcat(groupUniqArrayIf(attributes['mikka.thread_id'], notEmpty(coalesce(attributes['mikka.thread_id'], ''))), ', ') AS thread_ids,\n    arrayStringConcat(groupUniqArrayIf(attributes['mikka.task_id'], notEmpty(coalesce(attributes['mikka.task_id'], ''))), ', ') AS task_ids,\n    count() AS observed_spans,\n    countIf(status_code = 2) AS error_spans,\n    round(dateDiff('millisecond', min(timestamp), max(end_time)), 2) AS observed_elapsed_ms\nFROM posthog.trace_spans\nWHERE timestamp >= now() - toIntervalHour(least(greatest({lookback_hours}, 1), 336))\n  AND service_name IN ('mikka-web', 'mikka-daemon')\nGROUP BY trace_id\nORDER BY min(timestamp) DESC\nLIMIT 40",
        "code_utf8_bytes": 1036,
        "code_sha256": "08a86412357564d773b33a2a53e234f534664f3c4b2bf6724230ee69df608ad6",
        "status": "done",
        "depends_on": [],
        "dependents": [],
        "last_run_metadata": {
          "status": "done",
          "finished_at": "2026-11-06T19:43:08.934656Z",
          "row_count": 40
        }
      },
      {
        "node_id": "3f5a1c64-b0de-4a32-be51-341666af8a79",
        "cell_type": "sql",
        "dataframe_name": "runtime_span_timeline",
        "code": "WITH matched_traces AS (\n    SELECT DISTINCT trace_id\n    FROM posthog.trace_spans\n    WHERE timestamp >= now() - toIntervalHour(least(greatest({lookback_hours}, 1), 336))\n      AND service_name IN ('mikka-web', 'mikka-daemon')\n      AND (\n          ({run_id} != '' AND coalesce(attributes['mikka.run_id'], '') = {run_id})\n          OR ({thread_id} != '' AND coalesce(attributes['mikka.thread_id'], '') = {thread_id})\n          OR ({task_id} != '' AND coalesce(attributes['mikka.task_id'], '') = {task_id})\n          OR ({trace_id} != '' AND trace_id = base64Encode(unhex({trace_id})))\n      )\n    LIMIT 100\n)\nSELECT\n    formatDateTime(toTimeZone(timestamp, 'UTC'), '%Y-%m-%d %H:%i:%S') AS started_utc,\n    lower(hex(base64Decode(trace_id))) AS trace_id_hex,\n    lower(hex(base64Decode(span_id))) AS span_id_hex,\n    lower(hex(base64Decode(parent_span_id))) AS parent_span_id_hex,\n    service_name,\n    name AS stage,\n    dateDiff('millisecond', min(timestamp) OVER (PARTITION BY trace_id), timestamp) AS offset_ms,\n    round(duration_nano / 1000000, 2) AS duration_ms,\n    status_code,\n    is_root_span,\n    attributes['mikka.run_id'] AS run_id,\n    attributes['mikka.thread_id'] AS thread_id,\n    attributes['mikka.task_id'] AS task_id,\n    attributes['mikka.workflow_run_id'] AS workflow_run_id,\n    attributes['mikka.error.code'] AS error_code,\n    attributes['error.type'] AS error_type,\n    attributes['sessionId'] AS session_id\nFROM posthog.trace_spans\nWHERE timestamp >= now() - toIntervalHour(least(greatest({lookback_hours}, 1), 336))\n  AND service_name IN ('mikka-web', 'mikka-daemon')\n  AND trace_id IN (SELECT trace_id FROM matched_traces)\nORDER BY timestamp, duration_nano DESC\nLIMIT 2000",
        "code_utf8_bytes": 1702,
        "code_sha256": "3b151c0b6157266b6082873247d752133b799824eb61c48df5d45366d1073222",
        "status": "done",
        "depends_on": [],
        "dependents": [],
        "last_run_metadata": {
          "status": "done",
          "finished_at": "2026-11-06T19:43:11.424491Z",
          "row_count": 0
        }
      },
      {
        "node_id": "3c4b2757-6de2-4d50-bfe8-0b6991b68b00",
        "cell_type": "sql",
        "dataframe_name": "runtime_logs",
        "code": "WITH matched_traces AS (\n    SELECT DISTINCT trace_id\n    FROM posthog.trace_spans\n    WHERE timestamp >= now() - toIntervalHour(least(greatest({lookback_hours}, 1), 336))\n      AND service_name IN ('mikka-web', 'mikka-daemon')\n      AND (\n          ({run_id} != '' AND coalesce(attributes['mikka.run_id'], '') = {run_id})\n          OR ({thread_id} != '' AND coalesce(attributes['mikka.thread_id'], '') = {thread_id})\n          OR ({task_id} != '' AND coalesce(attributes['mikka.task_id'], '') = {task_id})\n          OR ({trace_id} != '' AND trace_id = base64Encode(unhex({trace_id})))\n      )\n    LIMIT 100\n)\nSELECT\n    formatDateTime(toTimeZone(timestamp, 'UTC'), '%Y-%m-%d %H:%i:%S') AS logged_utc,\n    lower(hex(base64Decode(trace_id))) AS trace_id_hex,\n    lower(hex(base64Decode(span_id))) AS span_id_hex,\n    service_name,\n    severity_text,\n    if(body IN ('mikka.stage.completed', 'mikka.stage.failed'), body, '') AS event_name,\n    attributes['mikka.stage'] AS stage,\n    toFloatOrNull(attributes['mikka.duration_ms']) AS duration_ms,\n    attributes['mikka.run_id'] AS run_id,\n    attributes['mikka.thread_id'] AS thread_id,\n    attributes['mikka.task_id'] AS task_id,\n    attributes['mikka.workflow_run_id'] AS workflow_run_id,\n    attributes['mikka.error.code'] AS error_code,\n    attributes['error.type'] AS error_type\nFROM logs\nWHERE timestamp >= now() - toIntervalHour(least(greatest({lookback_hours}, 1), 336))\n  AND service_name IN ('mikka-web', 'mikka-daemon')\n  AND trace_id IN (SELECT trace_id FROM matched_traces)\nORDER BY timestamp\nLIMIT 1000",
        "code_utf8_bytes": 1564,
        "code_sha256": "d81f0259ddb5f9e7118830913f5d66300d5db8c1167c79c9f0ffeb25ca4bac5f",
        "status": "done",
        "depends_on": [],
        "dependents": [],
        "last_run_metadata": {
          "status": "done",
          "finished_at": "2026-11-06T19:43:13.869304Z",
          "row_count": 0
        }
      }
    ],

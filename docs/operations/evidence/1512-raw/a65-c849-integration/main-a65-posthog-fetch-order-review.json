  "sourceSequence": [
    {
      "order": 1,
      "source": "feature instrumentation-client.ts:11-30",
      "action": "posthog.init enables tracing_headers for the official/current hostname; main a65 does not configure this option."
    },
    {
      "order": 2,
      "source": "posthog-js/lib/src/extensions/tracing-headers.js:58-70,107-110; lib/src/entrypoints/external-scripts-loader.js:52-68",
      "action": "When the extension is not already installed, its script load callback installs the fetch wrapper later. A cached script still uses an asynchronous load event."
    },
    {
      "order": 3,
      "source": "main apps/frontend/src/web/runtime.ts:1-6; lib/web-connection/browser.ts:24-34",
      "action": "The synchronous runtime installs deployment fetch then directory fetch, capturing the previously installed fetch."
    },
    {
      "order": 4,
      "source": "@posthog/browser-common/dist/utils/patch.js:39-63",
      "action": "The later patch captures the current window.fetch as layer.next and replaces the property; it does not unwrap the directory."
    },
    {
      "order": 5,
      "source": "posthog-js/lib/src/entrypoints/tracing-headers.js:131-194",
      "action": "The outer wrapper observes the original official request URL, adds only X-POSTHOG-SESSION-ID, X-POSTHOG-WINDOW-ID and X-POSTHOG-DISTINCT-ID, and passes the resulting Request/init to directory fetch."
    },
    {
      "order": 6,
      "source": "main lib/web-connection/client.ts:224-238",
      "action": "The selected-backend branch rewrites official /api/rpc to remote /api/desktop/rpc while deleting authority/pin headers but retaining those three telemetry headers."
    },
    {
      "order": 7,
      "source": "main lib/web-connection/transport.ts:4-8,65-71",
      "action": "The remote CORS preflight rejects these unlisted request-header names with web_connection_preflight_refused."
    }
  ],
  "orderCases": [
    {
      "extension": "lazy_after_directory",
      "result": "Official request is decorated before the remote rewrite; retained telemetry headers are outside the remote CORS allowlist."
    },
    {
      "extension": "already_loaded_before_directory",
      "result": "The captured inner PostHog wrapper sees the final remote URL and does not add official-host-only headers. This is why module import order alone is insufficient."
    },
    {
      "extension": "disabled_or_load_failed",
      "result": "This SDK adds no tracing headers; this specific preflight conflict does not arise."
    }
  ],
  "explicitLimits": [
    "This is fixed-source and installed-package composition evidence, not a captured production or browser network failure.",
    "The SDK code examined adds three X-PostHog headers, not traceparent or tracestate. No failure is attributed to an unobserved W3C header.",
    "Normal official Cloud requests remain same-origin; their telemetry headers should be preserved.",
    "The current default-production acceptance driver is still official-Cloud-bound; the operator must independently confirm the browser has no active self-hosted backend."
  ],
  "minimalRecommendation": {
    "boundary": "selected-backend request rewrite",
    "change": "Strip the three proven official X-PostHog correlation headers only when adapting traffic to the selected backend; preserve the official Cloud path. Do not widen remote CORS merely to transmit official person/session identifiers.",

  "findings": [
    {
      "id": "cross_origin_auth_before_trace",
      "classification": "confirmed_observability_gap",
      "paths": [
        "apps/api/src/application.ts:59-64",
        "apps/api/src/index.ts:10-15",
        "lib/web-connection/transport.ts:84-100",
        "lib/tracing/node.ts:90-120"
      ],
      "facts": [
        "The new prepared transport awaits fresh bearer authentication before beginTrace and request-scope creation.",
        "Prepared 401/403/503 and OPTIONS responses return before beginTrace.",
        "The feature tracing provider registers PostgreSQL instrumentation with requireParentSpan=true; it does not register an inbound HTTP instrumentation fallback."
      ],
      "impact": "New selected-backend cross-origin authentication and early rejection lack the normal API trace/route context.",
      "defaultCloudBoundary": "No-Origin or same-Origin requests return null at transport line54, before authentication. The existing official Cloud driver and native same-server protocol do not enter this new authentication branch.",
      "mergeReviewAction": "Preserve the original H3 request as trace source and its disposal/after lifetime; if closing this gap, establish the existing trace around transport preparation without weakening fresh authentication."
    },
    {
      "id": "new_backend_carrier_not_enabled",
      "classification": "confirmed_scope_limit",
      "paths": [
        "lib/web-connection/transport.ts:4-8,65-71",
        "instrumentation-client.ts",
        "apps/frontend/src/web/runtime.ts"
      ],
      "facts": [
        "The CORS request-header allowlist does not include traceparent, tracestate, x-posthog-session-id or x-posthog-distinct-id.",
        "The feature browser tracing host configuration is scoped to the current/official hostname; no self-hosted host is newly added by this delta."
      ],
      "impact": "The new self-hosted browser lane cannot be described as having verified browser-to-backend trace/Replay continuity. An explicitly supplied omitted header would be rejected by preflight; normal functionality is not asserted to fail merely because no such header is sent.",
      "mergeReviewAction": "Do not add arbitrary hosts or forward correlation to unapproved destinations to silence this finding; any new-backend telemetry policy needs an explicit supported-host contract."
    },
    {
      "id": "version_is_renderer_not_selected_backend",
      "classification": "production_operator_precondition",
      "paths": [
        "lib/web-connection/client.ts:203-238",
        "lib/web-connection/selection.ts"
      ],
      "facts": [
        "Official /api/version remains anonymous and official-cloud-bound even while a remote backend is selected.",
        "Other application API calls are rewritten to the selected backend, including /api/rpc to /api/desktop/rpc."
      ],
      "check": "Before the Claude browser-ready task, select Cloud/null through the normal UI and verify that credential-free selected-backend state; an official URL or servedSHA alone is insufficient. The independent driver remains bound to its exact official API origin."
    },
    {
      "id": "builtin_live_session_authority",
      "classification": "intentional_new_runtime_and_budget_boundary",
      "paths": [
        "app/api/live/ticket/route.ts",
        "lib/live/scope.ts",
        "lib/live/session-ticket.ts",
        "apps/api/routes/builtin-gateway.ts:10-18",
        "lib/builtin-gateway/hub.ts:53-74",
        "lib/builtin-gateway/postgres.ts:137-145",
        "drizzle/20261107160000_live_session_revocation.sql"
      ],
      "facts": [
        "Builtin tickets bind the real authenticated session; worker/device ticket protocol remains unchanged.",
        "Builtin upgrade and open each perform a fresh session-existence/expiry query.",
        "Deletion notifications are delivered after commit; exact-session revocation cannot be undone by a late successful open check.",
        "The normal release must apply the new migration and deploy mutually compatible ticket/receiver code."
      ],
      "queryBoundary": "There are two explicit session-authority SQL reads per builtin live connection and no new per-frame or polling read in this implementation. This is not an estimate of the full Native window; worker mode is unchanged."
    },
    {
      "id": "merge_fences_and_identity_scope",
      "classification": "required_merge_constraints",
      "paths": [
        "apps/frontend/src/web/auth-routing.ts",
        "apps/frontend/src/web/platform.tsx",
        "apps/frontend/src/web/rpc.ts",
        "apps/desktop/src/renderer/app.tsx",
        "components/authenticated-read-cache.tsx",
        "lib/swr/persistent-cache.ts",
        "package.json",
        ".github/workflows/ui-policy.yml"
      ],
      "requirements": [
        "Retain feature bootstrapScope/isDesktopHandoffPage and the authentication-to-workspace fresh authorization fence while incorporating main webFlow and directory/cloud subscriptions.",
        "Keep desktopFlow PKCE validation and existing OAuth/Composio priority; do not classify every sign-in page as identity-only.",
        "AND the existing owner/request-generation guard with webSelectionVersion; preserve selected-backend abort/late-response checks.",
        "Cloud-null persistent namespaces remain the existing v1 form; remote namespaces include the server identity.",
        "Retain all feature tracing/Replay/read-batch/desktop-auth tests and add main web-auth and builtin revocation entries.",
        "Keep the feature atomic desktop grant consumption; main web grants use a domain-separated state hash and do not replace the desktop exchange."
      ]
    }
  ],

        "@workflow/core/dist/runtime.js:596",
        "@workflow/core/dist/runtime.js:600"
      ],
      "contract": "SDK reads mode per delivery, not once during module import. Default linked keeps local delivery parent and adds an origin link. In continuous mode it restores the incoming carrier as parent and links to the delivery context instead; nextTraceCarrier serializes the current active context."
    },

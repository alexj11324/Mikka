  "findings": [
    {
      "code": "net_difference_not_unique_extra_query",
      "detail": "The measured +1 is the net of several positive and negative operation buckets; it does not identify one uniquely unnecessary SQL query."
    },
    {
      "code": "same_logical_starts",
      "detail": "Both clients started the same 19 logical RPC actions, with identical per-action start counts. Native completed all 19 in-window; hosted completed 16, with three paired cross-end completions."
    },
    {
      "code": "task_run_consumer_required",
      "source": "components/desktop/desktop-integration.tsx:30-39; hooks/use-live-lists.ts:90-101",
      "detail": "Both bundled and hosted are Electron desktop runtimes. The task-run read maintains badge/notification state and shares the same owner key with Board. Disabling it would remove product behavior."
    },
    {
      "code": "task_run_query_shape",
      "source": "app/actions/task-runs.ts:52-78; lib/live/revision-read.ts:22-28",
      "detail": "Each poll authorizes the current session, reads owner scope/revision before data, performs one bounded newest-run rows query, then reuses the begun scope. No per-row/N+1 query or second task-data SELECT was found."
    },
    {
      "code": "initial_live_catchup_requires_proof",
      "source": "lib/live/channel.ts:395-419; lib/swr/read-observer.ts:82-96",
      "detail": "Socket open creates a fresh invalidation boundary. A read whose fetcher began before that boundary cannot satisfy the catch-up. Later subscriptions require continuous acknowledged coverage and an actually committed matching read/revision."
    },
    {
      "code": "actual_provenance_unavailable",
      "detail": "These artifacts do not contain per-read began/coverage barriers or the Live open/ready/push event sequence. They cannot prove this specific second task-run request was redundant."
    }
  ],

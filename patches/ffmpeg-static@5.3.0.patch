--- /dev/null
+++ b/mikka-install.js
@@ -0,0 +1,240 @@
+'use strict'
+
+const fs = require('node:fs')
+const fsp = require('node:fs/promises')
+const https = require('node:https')
+const os = require('node:os')
+const path = require('node:path')
+const { createHash } = require('node:crypto')
+const { createGunzip } = require('node:zlib')
+const { pipeline } = require('node:stream/promises')
+const manifest = require('./mikka-assets.json')
+
+const RELEASE_ROOT = 'https://github.com/eugeneware/ffmpeg-static/releases/download'
+const API_ROOT = 'https://api.github.com/repos/eugeneware/ffmpeg-static/releases/assets/'
+const REDIRECT_HOSTS = new Set(['github.com', 'api.github.com', 'release-assets.githubusercontent.com',
+  'objects.githubusercontent.com', 'github-production-release-asset-2e65be.s3.amazonaws.com'])
+const ATTEMPT_MS = 30_000
+const MAX_REDIRECTS = 3
+
+const HOST_LABELS = new Map([
+  ['github.com', 'release'], ['api.github.com', 'api'],
+  ['release-assets.githubusercontent.com', 'release-assets'],
+  ['objects.githubusercontent.com', 'objects'],
+  ['github-production-release-asset-2e65be.s3.amazonaws.com', 'release-s3'],
+])
+const FILESYSTEM_CODES = new Set(['EACCES', 'EPERM', 'ENOSPC', 'EROFS', 'EISDIR', 'ENOTDIR'])
+const SAFE_CODES = new Set([...FILESYSTEM_CODES, 'ENOENT', 'ECONNRESET', 'ECONNREFUSED',
+  'ENOTFOUND', 'EAI_AGAIN', 'ETIMEDOUT', 'EPIPE', 'ABORT_ERR', 'ERR_STREAM_PREMATURE_CLOSE',
+  'ERR_INVALID_URL', 'Z_DATA_ERROR', 'Z_BUF_ERROR', 'CERT_HAS_EXPIRED',
+  'DEPTH_ZERO_SELF_SIGNED_CERT', 'UNABLE_TO_VERIFY_LEAF_SIGNATURE', 'ERR_TLS_CERT_ALTNAME_INVALID'])
+const SAFE_DETAILS = new Set(['Unexpected ffmpeg asset redirect', 'ffmpeg asset redirect limit',
+  'Unexpected ffmpeg asset content encoding', 'ffmpeg asset integrity mismatch',
+  'ffmpeg binary integrity mismatch', 'incorrect header check'])
+const SAFE_INSTALL_MESSAGES = new Set(['ffmpeg installation requires the pinned official release',
+  'Pinned ffmpeg installation cannot rewrite a custom binary path'])
+const diagnostics = new WeakMap()
+
+function integerHeader(value) {
+  if (typeof value !== 'string' || !/^(0|[1-9][0-9]{0,15})$/.test(value)) return null
+  const number = Number(value)
+  return Number.isSafeInteger(number) ? number : null
+}
+
+function retryHeader(value) {
+  if (typeof value !== 'string') return null
+  if (/^(0|[1-9][0-9]{0,9})$/.test(value)) return value
+  if (!/^(Mon|Tue|Wed|Thu|Fri|Sat|Sun), [0-9]{2} (Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) [0-9]{4} [0-9]{2}:[0-9]{2}:[0-9]{2} GMT$/.test(value)) return null
+  const date = new Date(value)
+  return !Number.isNaN(date.getTime()) && date.toUTCString() === value ? value : null
+}
+
+function safeCode(error) { return SAFE_CODES.has(error?.code) ? error.code : null }
+
+function attemptFailure(error, context, signal, started) {
+  const reason = signal.aborted ? 'deadline' : context.reason ||
+    (FILESYSTEM_CODES.has(error.code) ? 'filesystem' :
+      context.phase === 'decompress' ? 'decompression' :
+        context.phase === 'request' ? 'request' : 'stream')
+  const attempt = new Error('ffmpeg asset attempt failed', { cause: error })
+  diagnostics.set(attempt, { ...context, reason, code: safeCode(error),
+    detail: SAFE_DETAILS.has(error.message) ? error.message : null, elapsedMs: Date.now() - started })
+  return attempt
+}
+
+function assetFailure(name, attempts) {
+  const error = new AggregateError(attempts, 'Could not install verified ffmpeg asset ' + name,
+    { cause: attempts[attempts.length - 1] })
+  diagnostics.set(error, { message: error.message, asset: name,
+    attempts: attempts.map(attempt => diagnostics.get(attempt)) })
+  return error
+}
+
+// Causes stay available to programmatic callers. The install launcher prints
+// only this closed record, never raw Error/cause, URLs, headers or response bodies.
+function formatInstallError(error) {
+  return JSON.stringify(diagnostics.get(error) || {
+    message: SAFE_INSTALL_MESSAGES.has(error?.message) ? error.message : 'ffmpeg installation failed',
+    code: safeCode(error),
+  })
+}
+
+async function matches(file, expected, signal) {
+  try {
+    const stat = await fsp.lstat(file)
+    if (!stat.isFile() || stat.size !== expected.size) return false
+    const hash = createHash('sha256')
+    for await (const chunk of fs.createReadStream(file, { signal })) hash.update(chunk)
+    return hash.digest('hex') === expected.sha256
+  } catch (error) {
+    if (error.code === 'ENOENT') return false
+    throw error
+  }
+}
+
+async function responseFor(url, agent, signal, context, apiAuthorization) {
+  for (let redirects = 0; ; redirects++) {
+    const parsed = new URL(url)
+    Object.assign(context, { host: HOST_LABELS.get(parsed.hostname) || 'rejected', redirects,
+      phase: 'request', status: null, rateLimitRemaining: null, rateLimitReset: null, retryAfter: null })
+    if (parsed.protocol !== 'https:' || !REDIRECT_HOSTS.has(parsed.hostname) ||
+        parsed.username || parsed.password || (parsed.port && parsed.port !== '443')) {
+      context.reason = 'redirect'
+      throw new Error('Unexpected ffmpeg asset redirect')
+    }
+    const headers = { Accept: 'application/octet-stream', 'Accept-Encoding': 'identity',
+      'User-Agent': 'ffmpeg-static/5.3.0' }
+    // Only this fixed API source's first hop may use the explicit credential.
+    // Rebuild headers on every redirect, including same-host path/query changes.
+    if (apiAuthorization?.token && redirects === 0 && parsed.href === apiAuthorization.url &&
+        parsed.origin === 'https://api.github.com' && !parsed.search && !parsed.hash) {
+      headers.Authorization = 'Bearer ' + apiAuthorization.token
+    }
+    const response = await new Promise((resolve, reject) => {
+      const request = https.get(parsed, { agent, signal, headers }, resolve)
+      request.once('error', reject)
+    })
+    Object.assign(context, { phase: 'response', status: response.statusCode,
+      rateLimitRemaining: integerHeader(response.headers['x-ratelimit-remaining']),
+      rateLimitReset: integerHeader(response.headers['x-ratelimit-reset']),
+      retryAfter: retryHeader(response.headers['retry-after']) })
+    if ([301, 302, 303, 307, 308].includes(response.statusCode)) {
+      const location = response.headers.location
+      response.destroy()
+      if (!location || redirects >= MAX_REDIRECTS) {
+        context.reason = 'redirect'
+        throw new Error('ffmpeg asset redirect limit')
+      }
+      url = new URL(location, url).href
+      continue
+    }
+    if (response.statusCode !== 200) {
+      const status = response.statusCode
+      response.destroy()
+      context.reason = 'http'
+      throw new Error('ffmpeg asset HTTP ' + status)
+    }
+    return response
+  }
+}
+
+async function installAsset(name, destination, expected, agent, executable) {
+  if (await matches(destination, expected)) {
+    if (executable) await fsp.chmod(destination, 0o755)
+    return
+  }
+  const asset = manifest.assets[name]
+  const urls = [RELEASE_ROOT + '/' + manifest.release + '/' + name, API_ROOT + asset.id]
+  const attempts = []
+  for (const [index, url] of urls.entries()) {
+    const directory = await fsp.mkdtemp(path.join(path.dirname(destination), '.ffmpeg-install-'))
+    const controller = new AbortController()
+    const timer = setTimeout(() => controller.abort(new Error('ffmpeg asset deadline exceeded')), ATTEMPT_MS)
+    const { signal } = controller
+    const started = Date.now()
+    const context = { source: index === 0 ? 'release' : 'api' }
+    try {
+      const downloaded = path.join(directory, 'download')
+      const response = await responseFor(url, agent, signal, context,
+        index === 1 ? { url: API_ROOT + asset.id, token: process.env.FFMPEG_GITHUB_TOKEN } : undefined)
+      // Explicit identity encoding keeps the pinned .gz bytes unchanged.
+      if (response.headers['content-encoding'] &&
+          response.headers['content-encoding'] !== 'identity') {
+        response.destroy()
+        context.reason = 'content-encoding'
+        throw new Error('Unexpected ffmpeg asset content encoding')
+      }
+      context.phase = 'download'
+      await pipeline(response, fs.createWriteStream(downloaded, { flags: 'wx' }), { signal })
+      context.phase = 'verify-asset'
+      if (!await matches(downloaded, asset, signal)) {
+        context.reason = 'asset-integrity'
+        throw new Error('ffmpeg asset integrity mismatch')
+      }
+      let complete = downloaded
+      if (executable) {
+        complete = path.join(directory, 'binary')
+        context.phase = 'decompress'
+        await pipeline(fs.createReadStream(downloaded), createGunzip(),
+          fs.createWriteStream(complete, { flags: 'wx' }), { signal })
+        context.phase = 'verify-binary'
+        if (!await matches(complete, expected, signal)) {
+          context.reason = 'binary-integrity'
+          throw new Error('ffmpeg binary integrity mismatch')
+        }
+        await fsp.chmod(complete, 0o755)
+      }
+      signal.throwIfAborted()
+      context.phase = 'publish'
+      await fsp.rename(complete, destination)
+      return
+    } catch (error) {
+      attempts.push(attemptFailure(error, context, signal, started))
+      // Filesystem failures cannot be repaired by downloading the same asset again.
+      if (FILESYSTEM_CODES.has(error.code)) throw assetFailure(name, attempts)
+    } finally {
+      clearTimeout(timer)
+      controller.abort()
+      await fsp.rm(directory, { recursive: true, force: true })
+    }
+  }
+  throw assetFailure(name, attempts)
+}
+
+async function install() {
+  const pkg = require('./package.json')
+  const config = pkg[pkg.name]
+  if (pkg.version !== '5.3.0' || config['binary-release-tag'] !== manifest.release ||
+      (process.env.FFMPEG_BINARY_RELEASE && process.env.FFMPEG_BINARY_RELEASE !== manifest.release) ||
+      (process.env.FFMPEG_BINARIES_URL && process.env.FFMPEG_BINARIES_URL !== RELEASE_ROOT)) {
+    throw new Error('ffmpeg installation requires the pinned official release')
+  }
+  const platform = process.env.npm_config_platform || os.platform()
+  const arch = process.env.npm_config_arch || os.arch()
+  const key = platform + '-' + arch
+  const binaryName = 'ffmpeg-' + key
+  const expected = manifest.assets[binaryName]
+  const binaryPath = require('.')
+  if (!binaryPath || !expected || !manifest.assets[key + '.README'] ||
+      !manifest.assets[key + '.LICENSE'] || !manifest.assets[binaryName + '.gz']) {
+    throw new Error('No pinned ffmpeg assets for ' + key)
+  }
+  const packageBinary = path.join(__dirname, 'ffmpeg' + (platform === 'win32' ? '.exe' : ''))
+  if (path.resolve(binaryPath) !== packageBinary) {
+    throw new Error('Pinned ffmpeg installation cannot rewrite a custom binary path')
+  }
+  let agent = false
+  const proxyUrl = process.env.HTTPS_PROXY || process.env.https_proxy ||
+    process.env.HTTP_PROXY || process.env.http_proxy
+  if (proxyUrl) {
+    const HttpsProxyAgent = require('https-proxy-agent')
+    const { hostname, port, protocol } = new URL(proxyUrl)
+    agent = new HttpsProxyAgent({ hostname, port, protocol })
+  }
+  await installAsset(binaryName + '.gz', binaryPath, expected, agent, true)
+  await installAsset(key + '.README', binaryPath + '.README', manifest.assets[key + '.README'], agent, false)
+  await installAsset(key + '.LICENSE', binaryPath + '.LICENSE', manifest.assets[key + '.LICENSE'], agent, false)
+  console.info('ffmpeg binary, README and LICENSE verified.')
+}
+
+module.exports = { install, formatInstallError }

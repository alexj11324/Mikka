{
  "version": 1,
  "base": "base",
  "style": "base-nova",
  "iconLibrary": "lucide-react",
  "componentRoots": ["components/ui/", "components/reui/", "components/blocks/", "components/motion/", "components/agents/"],
  "typography": {
    "cssTokens": { "--text-md": "0.9375rem", "--text-md--line-height": "1.5rem", "--font-weight-normal": "450", "font-weight": "var(--font-weight-normal)", "font-synthesis": "none" },
    "sizes": ["xs", "sm", "md", "base", "lg", "xl", "2xl", "3xl", "4xl"],
    "weights": ["normal", "medium", "semibold", "bold"],
    "families": ["sans", "mono", "heading"],
    "googleFonts": ["Inter", "Geist_Mono"],
    "localFonts": [
      { "family": "Inter", "src": "app/fonts/InterVariable.woff2", "variable": "--font-inter" },
      { "family": "Inter", "src": "app/fonts/InterVariable-Italic.woff2", "variable": "--font-inter" },
      { "family": "Geist Mono", "src": "app/fonts/GeistMono-Variable.woff2", "variable": "--font-geist-mono" }
    ],
    "leading": ["none", "tight", "snug", "normal", "relaxed", "loose", "3", "4", "5", "5.5", "6", "7", "8", "9", "10"],
    "tracking": ["tighter", "tight", "normal", "wide", "wider", "widest"]
  }
}

# Set to the current cloud Preview origin, without /mikka.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
# Stable callback hub origin and a dedicated secret shared with trusted previews.
BETTER_AUTH_OAUTH_PROXY_URL=
BETTER_AUTH_OAUTH_PROXY_SECRET=
# Comma-separated project-controlled HTTPS origins or hostname patterns.
AUTH_TRUSTED_ORIGINS=
MIKKA_DATABASE_URL=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

COMPOSIO_API_KEY=
COMPOSIO_CALLBACK_VERIFIER_URL=
COMPOSIO_WEBHOOK_SECRET=

# Single-workspace Slack bot. Deliver secrets through Infisical cloud sync.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_ID=
SLACK_TEAM_ID=
SLACK_BOT_USER_ID=
# JSON mapping of verified Slack user ids to Mikka user ids.
SLACK_USER_BINDINGS=

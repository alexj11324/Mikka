# Set to the current cloud Preview origin, without /mikka.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
# Stable callback hub origin and a dedicated secret shared with trusted previews.
BETTER_AUTH_OAUTH_PROXY_URL=
BETTER_AUTH_OAUTH_PROXY_SECRET=
# Comma-separated project-controlled HTTPS origins or hostname patterns.
AUTH_TRUSTED_ORIGINS=
MIKKA_DATABASE_URL=

# Optional public name shown by discovery and the server information endpoint.
MIKKA_SERVER_NAME=
# Official web bearer connections use this exact HTTPS app URL; 0 disables them.
MIKKA_OFFICIAL_WEB_URL=https://app.aspectlylabs.com/mikka
MIKKA_OFFICIAL_WEB_ENABLED=1

# Optional self-hosted Claude / ChatGPT subscriptions. Use your own Infisical
# service/project and two distinct Universal Auth identities. See
# docs/self-hosting.md, "Subscription backend prerequisites" for permissions.
# The Docker image supplies the two worker binary paths; keep its defaults.
MIKKA_BYOS_INFISICAL_ORIGIN=
MIKKA_BYOS_INFISICAL_PROJECT=
MIKKA_BYOS_INFISICAL_ENVIRONMENT=
MIKKA_BYOS_INFISICAL_PATH=
MIKKA_BYOS_ACCESS_INFISICAL_PATH=
MIKKA_BYOS_CUSTODY_CLIENT_ID=
MIKKA_BYOS_CUSTODY_CLIENT_SECRET=
MIKKA_BYOS_ACCESS_CLIENT_ID=
MIKKA_BYOS_ACCESS_CLIENT_SECRET=
# Optional: a separate project for the access-only path.
# MIKKA_BYOS_ACCESS_INFISICAL_PROJECT=
# Alternative to the two Universal Auth identities: two distinct scoped tokens.
# MIKKA_BYOS_INFISICAL_TOKEN=
# MIKKA_BYOS_ACCESS_INFISICAL_TOKEN=

# Cloud worker configuration remains disabled until the complete Bot task flow
# and provider authorization have been verified. URL includes the app base path.
MIKKA_CLOUD_COMPUTER_TASKS=0
MIKKA_CLOUD_WORKER_URL=
MIKKA_CLOUD_WORKER_SHA=
# Optional UI gate for an isolated Vercel Preview; never turns on production.
NEXT_PUBLIC_COMPUTER_ACCEPTANCE=0

# Mikka 默认 (the default model) calls ZeroCat first (lib/abuse/zerocat.ts).
# Values live in Infisical prod:/vercel and sync to Vercel; never commit them.
# Without both, or when ZeroCat fails before its first token, it uses AI Gateway.
ZEROCAT_BASE_URL=https://zero.cat/v1
ZEROCAT_API_KEY=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Server administrators are assigned explicitly by the operator (comma-separated Mikka user IDs).
MIKKA_SERVER_ADMIN_USER_IDS=
# Optional: use the stored server GitHub App as the sign-in provider; restart after setup.
GITHUB_SIGN_IN_USE_APP=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

COMPOSIO_API_KEY=
COMPOSIO_CALLBACK_VERIFIER_URL=
COMPOSIO_WEBHOOK_SECRET=

# Single-workspace Slack bot. Deliver secrets through Infisical cloud sync.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_ID=
SLACK_TEAM_ID=
SLACK_BOT_USER_ID=
# JSON mapping of verified Slack user ids to Mikka user ids.
SLACK_USER_BINDINGS=

# Optional: Expo push access token, when "enhanced push security" is on for the iOS app (lib/mobile-push.ts).
EXPO_ACCESS_TOKEN=

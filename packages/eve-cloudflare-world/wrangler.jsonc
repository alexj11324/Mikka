{
  "name": "mikka-eve-world",
  "main": "src/authority.mjs",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "EVE_WORLD", "class_name": "EveWorldAuthority" },
      { "name": "EVE_STREAMS", "class_name": "EveWorldStream" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["EveWorldAuthority"] },
    { "tag": "v2", "new_sqlite_classes": ["EveWorldStream"] }
  ]
}

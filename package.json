{
  "name": "next-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbopack",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "lint": "pnpm lint:code && pnpm lint:ui",
    "lint:code": "oxlint --deny-warnings",
    "lint:ui": "node scripts/lint-ui.mjs",
    "test:ui-policy": "node --test scripts/ui-policy.test.mjs",
    "test:i18n": "node --test scripts/check-i18n.test.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test:ssh-target": "node --import tsx --test lib/ssh-target.test.ts",
    "start": "next start",
    "typecheck": "tsgo --noEmit",
    "daemon": "pnpm --filter @orvilo/daemon exec tsx bin/orvilo.ts daemon --server http://localhost:3000",
    "daemon:login": "pnpm --filter @orvilo/daemon exec tsx bin/orvilo.ts daemon login --server http://localhost:3000"
  },
  "dependencies": {
    "@base-ui/react": "latest",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@orvilo/protocol": "workspace:*",
    "@shadcn/react": "^0.3.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-collaboration": "^3.32.0",
    "@tiptap/extension-collaboration-caret": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "@tiptap/y-tiptap": "^3.0.10",
    "@vercel/analytics": "1.3.1",
    "better-auth": "^1.7.12",
    "class-variance-authority": "latest",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "latest",
    "date-fns": "4.1.0",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "8.5.1",
    "input-otp": "1.4.1",
    "lucide-react": "latest",
    "next": "16.1.6",
    "next-intl": "^4.14.9",
    "next-themes": "latest",
    "pg": "^8.23.1",
    "react": "^19.2.4",
    "react-day-picker": "9.8.0",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^4.14.7",
    "recharts": "3.10.1",
    "shadcn": "latest",
    "shiki": "^4.5.0",
    "sonner": "^1.7.4",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "latest",
    "vaul": "^1.1.2",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.1.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxlint": "^1.89.0",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.9.3"
  }
}

+    const value = snapshot('bots')
+    return { ...value, items: [{ id: 'bots', title: `revision-${revision}` }], live: { ...value.live, revisions: { [`bot_chat_list:${home}`]: revision } } }
+  }
+  replies.set('bots', async () => snapshotAt(5))

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --filter '!@mikka/mobile'",
  "build": {
    "env": {
      "NEXT_ENABLE_ADAPTER": "0"
    }
  },
  "functions": {
    "app/api/coordinator/stream/route.ts": {
      "supportsCancellation": true
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false,
      "**": false
    }
  },
  "crons": [
    { "path": "/mikka/api/cron/linear-sync", "schedule": "0 4 * * *" }
  ]
}

+        sourceCommit:i.liveSourceCommit,fixtureKey:kind,fixtureRunKey,status:'observed',
+        modelMessagesAddedForLive:0,observation:inner,
+        live:{schemaVersion:1,issue:1506,case:'real-live-core-consumers',status:'live_evidence_captured',

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mikka-suggestions-cron",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-22",
  // Scheduled calls only; no public Worker or version preview URL.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["0 * * * *"] },
  "vars": { "MIKKA_URL": "https://app.aspectlylabs.com/mikka" },
  "observability": { "enabled": true }
}

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mikka-task-sandbox",
  "main": "machine.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "NATIVE_TASK_EGRESS": "direct" },
  "limits": { "cpu_ms": 2000 },
  "durable_objects": { "bindings": [
    { "name": "TASKS", "class_name": "TaskMachine" },
    { "name": "CAPACITY", "class_name": "TaskCapacity" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TaskMachine", "TaskCapacity"] }],
  "r2_buckets": [{ "binding": "WORKSPACES", "bucket_name": "mikka-task-workspaces" }],
  "containers": [{
    "name": "mikka-task-sandbox",
    "class_name": "TaskMachine",
    "scheduling_policy": "durable_object",
    "images": { "task": { "dockerfile": "./Dockerfile", "build_context": "../.." } }
  }]
}

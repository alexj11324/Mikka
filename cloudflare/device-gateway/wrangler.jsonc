{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mikka-device-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  // Free plan Durable Objects are SQLite-backed. The session does not write
  // rows on the heartbeat; the class is SQLite so the free plan can create it.
  "workers_dev": true,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "DEVICE_SESSION", "class_name": "DeviceSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeviceSession"] }]
}

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mikka-legacy-orvilo-redirect",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "orvilo.aspectlylabs.com/*", "zone_name": "aspectlylabs.com" }],
  "observability": { "enabled": true }
}

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mikka-litellm",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "LITELLM_CONTAINER", "class_name": "LiteLlm" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiteLlm"] }],
  "containers": [{
    "class_name": "LiteLlm",
    "image": "../../deploy/litellm/Dockerfile",
    "instance_type": "basic",
    "max_instances": 1
  }]
}

{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "neverConnectToCloud": true,
  "plugins": ["./scripts/ci/nx-plugin.mjs"],
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/pnpm-lock.yaml", "{workspaceRoot}/pnpm-workspace.yaml", "{workspaceRoot}/tsconfig.json", "{workspaceRoot}/nx.json", "{workspaceRoot}/scripts/ci/**/*"]
  },
  "targetDefaults": { "check": { "cache": false }, "test": { "cache": false }, "build": { "cache": false }, "typecheck": { "cache": false } },
  "parallel": 2,
  "tui": { "enabled": false }
}

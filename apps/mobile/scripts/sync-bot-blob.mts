// Regenerates apps/mobile/lib/bot-blob.ts — run after bot-shapes.ts or bloub change:
//   node --experimental-strip-types apps/mobile/scripts/sync-bot-blob.mts
// The 64 polar radii per shape are what the web's bloub avatar morphs
// (SHAPE_BY_ID for the 8 it ships, extraShapeRadii for the 8 drawn in
// lib/bot-shapes.ts); the iOS app draws the same outlines in react-native-svg.
import { writeFileSync } from 'node:fs'
import { BOT_SHAPES, extraShapeRadii } from '../../../lib/bot-shapes.ts'

const { SHAPE_BY_ID } = await import('@norbert_bodziony/bloub')

const rows = BOT_SHAPES.map(id => {
  const radii = SHAPE_BY_ID.get(id)?.radii ?? extraShapeRadii(id)
  return `  ${id}: [${radii.map(value => +value.toFixed(3)).join(', ')}],`
})

writeFileSync(new URL('../lib/bot-blob.ts', import.meta.url), `// Generated by scripts/sync-bot-blob.mts — edit the sources, not this file.
// The web's sixteen bot shapes (lib/bot-shapes.ts BOT_SHAPES), each as the 64
// polar radii bloub morphs (unit: body radius).

export const BOT_SHAPE_IDS = [${BOT_SHAPES.map(id => `'${id}'`).join(', ')}] as const

export const BOT_BLOB_RADII: Record<string, readonly number[]> = {
${rows.join('\n')}
}
`)

{
  "expo": {
    "name": "Mikka",
    "slug": "mikka",
    "scheme": "mikka",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.aspectlylabs.mikka",
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}

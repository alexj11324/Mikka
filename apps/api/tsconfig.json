{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "types": ["node"],
    "paths": {
      "@/*": ["../../*"],
      "@/i18n/navigation": ["./compat/localized-navigation.ts"],
      "next/server": ["./compat/server.ts"],
      "next/headers": ["./compat/headers.ts"],
      "next/headers.js": ["./compat/headers.ts"],
      "next/navigation": ["./compat/navigation.ts"],
      "next-intl/server": ["./compat/intl.ts"],
      "server-only": ["./compat/server-only.ts"],
      "react": ["./compat/react.ts"],
      "mikka-real-react": ["../../node_modules/@types/react/index.d.ts"]
